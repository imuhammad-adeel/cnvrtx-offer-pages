---
/** Visible breadcrumb trail. The matching structured data is added by SiteLayout. */
import type { Crumb } from '../layouts/SiteLayout.astro';
interface Props {
  crumbs: Crumb[];
}
const trail = [{ label: 'Home', href: '/' }, ...Astro.props.crumbs];
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {trail.map((c, i) => <li>{i === trail.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}</li>)}
  </ol>
</nav>
