---
/**
 * Legal pages on cnvrtx.com: /legal/<slug>. Same words and the same config as the copies on
 * get.cnvrtx.com (src/content/legal.ts), so the two can never disagree.
 * They stay out of Google until a lawyer has reviewed them (offerV9.legalInfo.reviewed).
 */
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { legalDocs, type LegalDoc } from '../../../src/content/legal';
import { automotiveOffer as o } from '../../../src/config/automotiveOffer';
import { offerV9 as cfg, featuredPlan as plan, fillOffer } from '../../../src/config/offerV9';
import { money } from '../../config/site';

export function getStaticPaths() {
  return legalDocs.map((doc) => ({ params: { doc: doc.slug }, props: { doc } }));
}
interface Props {
  doc: LegalDoc;
}
const { doc } = Astro.props;
const info = cfg.legalInfo;
const date = new Date(info.effectiveDate + 'T12:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const contact = info.supportEmail
  ? `Contact ${o.brand.legalName} at ${info.supportEmail}${info.address ? `, or by mail at ${info.address}` : ''}.`
  : `Contact ${o.brand.legalName} through the contact link in the footer of this website.`;
const governing = info.governingState
  ? `These terms are governed by the laws of the State of ${info.governingState}, without regard to its conflict of law rules. Disputes will be heard in the courts located there.`
  : 'These terms are governed by the laws of the state where our company is registered, without regard to its conflict of law rules.';
const fill = (t: string) =>
  fillOffer(t)
    .replaceAll('{company}', o.brand.legalName)
    .replaceAll('{brand}', 'CNVRT X')
    .replaceAll('{contact}', contact)
    .replaceAll('{governing}', governing)
    .replaceAll('{monthly}', money(plan.monthly))
    .replaceAll('{annual}', money(plan.annual))
    .replaceAll('{kit}', money(plan.launchKit))
    .replaceAll('{website}', money(cfg.website.addOn));
const path = `/legal/${doc.slug}`;
const crumbs = [{ label: doc.nav, href: path }];
---

<SiteLayout title={`${doc.title} | CNVRT X`} description={fill(doc.intro).slice(0, 150)} path={path} crumbs={crumbs} noindex={!info.reviewed}>
  <main id="main">
    <PageHero crumbs={crumbs} title={[doc.title]} lede={`Effective ${date}`} />
    <section class="s-sec pearl">
      <div class="container">
        <ul class="s-chips" role="list" style="margin-bottom:28px" aria-label="Legal pages">
          {
            legalDocs.map((d) => (
              <li>
                <a href={`/legal/${d.slug}`} aria-current={d.slug === doc.slug ? 'page' : undefined}>
                  {d.nav}
                </a>
              </li>
            ))
          }
        </ul>
        <article class="s-doc">
          <p>{fill(doc.intro)}</p>
          {
            doc.sections.map((s) => (
              <Fragment>
                <h2>{s.h}</h2>
                {s.body.map((b) =>
                  Array.isArray(b) ? (
                    <ul>
                      {b.map((li) => (
                        <li>{fill(li)}</li>
                      ))}
                    </ul>
                  ) : (
                    <p>{fill(b)}</p>
                  ),
                )}
              </Fragment>
            ))
          }
        </article>
      </div>
    </section>
  </main>
</SiteLayout>
