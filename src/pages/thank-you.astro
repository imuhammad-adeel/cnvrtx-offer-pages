---
/**
 * After checkout: get.cnvrtx.com/thank-you (the checkout pages send every plan here).
 *
 * The buyer's own account does not exist yet when this page loads, so nothing is embedded
 * here: no form, no survey. The page says what to expect: a login email, then the Setup Center
 * inside their account, where they answer the setup questions.
 *
 * All wording is in flow9.thanks (src/content/automotiveCopyV9.ts). The support email comes
 * from src/config/offerV9.ts; with none set, the line only says to check spam.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { flow9 } from '../content/automotiveCopyV9';
import { offerV9 as cfg } from '../config/offerV9';
import '../styles/v9.css';
const t = flow9.thanks;
const support = cfg.contact.email || cfg.legalInfo.supportEmail;
---

<BaseLayout title={t.pageTitle} description={t.pageDescription} noindex={true} bodyClass="v9" themeColor="#070B10">
  <header class="top">
    <a href="/" class="logo" aria-label="CNVRT X home">CNVRT<span>✕</span></a>
  </header>

  <main id="main" class="wrap">
    <p class="badge"><span aria-hidden="true">✓</span>{t.kicker}</p>
    <h1>
      {t.title[0]}<br /><span class="hot">{t.title[1]}</span>
    </h1>
    <p class="lede">{t.lead}</p>

    {/* a div with a region role, not <section>: the site lazy-renders <section>s in <main>, which would shift this page as it loads */}
    <div class="setup" role="region" aria-labelledby="setup-title">
      <h2 id="setup-title">{t.stepsTitle}</h2>
      <ol role="list" class="steps">
        {
          t.steps.map((s, i) => (
            <li>
              <span class="n" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="help">
        {t.noEmail}
        {
          support && (
            <>
              {' '}
              {t.noEmailContact} <a href={`mailto:${support}`}>{support}</a>.
            </>
          )
        }
      </p>
    </div>

    <div class="after" role="region" aria-labelledby="next-title">
      <h2 id="next-title">{t.timelineTitle}</h2>
      <ol role="list" class="line">
        {
          t.timeline.map((x) => (
            <li>
              <b>{x.t}</b>
              <span>{x.d}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <aside class="refer">
      <div>
        <h2>{t.referTitle}</h2>
        <p>{t.referLine}</p>
      </div>
      <button type="button" class="copy" data-copy data-url="/" data-done={t.referDone}>{t.referCta}</button>
    </aside>
  </main>
</BaseLayout>

<script>
  import { track } from '../scripts/analytics';
  track('thank_you_view', { paid: new URLSearchParams(location.search).has('paid') });

  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  btn?.addEventListener('click', async () => {
    const url = location.origin + (btn.dataset.url || '/');
    try {
      await navigator.clipboard.writeText(url);
      btn.textContent = btn.dataset.done || '';
    } catch {
      btn.textContent = url;
    }
    track('referral_copy');
  });
</script>

<style>
  .top {
    padding: 20px var(--gutter);
    max-width: calc(980px + var(--gutter) * 2);
    margin-inline: auto;
  }
  .logo {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 1.25rem;
    color: #fff;
    text-decoration: none;
  }
  .logo span {
    color: var(--hot);
    margin-left: 3px;
  }
  .wrap {
    max-width: calc(980px + var(--gutter) * 2);
    margin-inline: auto;
    padding: clamp(1.5rem, 1rem + 3vw, 4rem) var(--gutter) clamp(4rem, 3rem + 4vw, 7rem);
    display: grid;
    gap: var(--s-5);
    justify-items: start;
    color: #eef3f7;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(61, 220, 151, 0.14);
    border: 1px solid rgba(61, 220, 151, 0.5);
    color: #9fe8c8;
    font-size: 0.8125rem;
    font-weight: 800;
  }
  h1 {
    font-size: clamp(2.4rem, 1.2rem + 5vw, 5.6rem);
    letter-spacing: -0.055em;
  }
  .lede {
    max-width: 56ch;
  }

  /* ---------- 3 steps to go live ---------- */
  .setup,
  .after {
    width: 100%;
    display: grid;
    gap: var(--s-4);
  }
  .setup {
    margin-top: var(--s-4);
  }
  .setup h2,
  .after h2 {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem);
    letter-spacing: -0.04em;
  }
  .steps {
    margin: 0;
    display: grid;
    gap: 12px;
  }
  .steps li {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    padding: clamp(1.1rem, 0.9rem + 1vw, 1.75rem);
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
  }
  .n {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #d8ff3e;
    color: #0b1016;
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 1.3rem;
  }
  .steps h3 {
    font-family: var(--f-head);
    font-weight: 700;
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .steps p {
    margin-top: 4px;
    line-height: 1.5;
    color: #dbe4ec;
  }
  .help {
    font-size: 0.9375rem;
    color: var(--fog);
  }
  .help a {
    color: #fff;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  /* ---------- what happens next ---------- */
  .after {
    margin-top: var(--s-5);
  }
  .line {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 2px solid rgba(255, 255, 255, 0.2);
  }
  .line li {
    position: relative;
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 22px 20px 0 0;
  }
  .line li::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--hot);
  }
  .line b {
    font-family: var(--f-head);
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }
  .line span {
    line-height: 1.5;
    color: var(--fog);
  }

  .refer {
    margin-top: var(--s-6);
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-5);
    flex-wrap: wrap;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border-radius: 24px;
    background: #d8ff3e;
    color: #0b1016;
  }
  .refer h2 {
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem);
    letter-spacing: -0.04em;
  }
  .refer p {
    margin-top: 4px;
    font-weight: 600;
  }
  .copy {
    min-height: 52px;
    padding: 0 24px;
    border: 0;
    border-radius: 999px;
    background: #0b1016;
    color: #fff;
    font-family: var(--f-head);
    font-weight: 700;
    cursor: pointer;
  }
  @media (max-width: 800px) {
    .line {
      grid-template-columns: 1fr;
      border-top: 0;
      border-left: 2px solid rgba(255, 255, 255, 0.2);
      row-gap: var(--s-5);
    }
    .line li {
      padding: 0 0 0 24px;
    }
    .line li::before {
      top: 6px;
      left: -8px;
    }
    .copy {
      width: 100%;
    }
  }
  @media (max-width: 480px) {
    .steps li {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 12px;
    }
    .n {
      width: 40px;
      height: 40px;
      font-size: 1.1rem;
    }
  }
</style>
