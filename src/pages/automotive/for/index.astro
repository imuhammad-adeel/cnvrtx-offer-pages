---
/** Review index for the front-door landing pages. Not for visitors; noindex. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { doors } from '../../../content/automotiveDoors';
import '../../../styles/v9.css';
---

<BaseLayout title="Front-door landing pages | CNVRT X" description="Review list of the problem-specific landing pages." noindex={true} bodyClass="v9" themeColor="#070B10">
  <main id="main" class="wrap">
    <p class="kicker">Review list</p>
    <h1>Front-door pages</h1>
    <p class="lede">One problem and one hook per page. Every page sells the same offer as the main page.</p>
    <ol role="list">
      <li class="main">
        <a href="/automotive/v9">
          <b>Main page</b>
          <span>You Got the Inquiry. Did You Get the Booking?</span>
        </a>
      </li>
      {
        doors.map((d, i) => (
          <li>
            <a href={`/automotive/for/${d.slug}`}>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <b>{d.label}</b>
              <span>
                {d.headline[0]} {d.headline[1]}
              </span>
              <em>{d.system}</em>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>

<style>
  .wrap {
    max-width: calc(980px + var(--gutter) * 2);
    margin-inline: auto;
    padding: clamp(3rem, 2rem + 4vw, 6rem) var(--gutter);
    display: grid;
    gap: var(--s-4);
  }
  h1 {
    font-size: clamp(2.4rem, 1.4rem + 4vw, 4.6rem);
    letter-spacing: -0.055em;
  }
  ol {
    margin: var(--s-5) 0 0;
    display: grid;
    gap: 8px;
  }
  a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 0.8fr) minmax(0, 1.6fr) auto;
    gap: 12px;
    align-items: center;
    padding: 16px 20px;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
    color: #eef3f7;
    text-decoration: none;
    transition: border-color 160ms;
  }
  a:hover {
    border-color: #d8ff3e;
  }
  .main a {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    border-color: rgba(216, 255, 62, 0.5);
  }
  .n {
    font-family: var(--f-head);
    font-weight: 800;
    color: #d8ff3e;
  }
  b {
    font-family: var(--f-head);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  a > span:not(.n) {
    color: var(--fog);
  }
  em {
    font-style: normal;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--fog-2);
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    a,
    .main a {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
