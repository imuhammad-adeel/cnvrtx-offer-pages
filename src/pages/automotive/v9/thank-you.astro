---
/** Last step of the flow. Shows "build started" or, with ?later=1, "one step left". */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { flow9 } from '../../../content/automotiveCopyV9';
import '../../../styles/v9.css';
const t = flow9.thanks;
---

<BaseLayout title="Thank you. Your CNVRT X build is booked in" description="What happens next with your CNVRT X system." noindex={true} bodyClass="v9" themeColor="#070B10">
  <header class="top">
    <a href="/automotive/v9" class="logo" aria-label="CNVRT X home">CNVRT<span>✕</span></a>
  </header>

  <main id="main" class="wrap" data-ty>
    <p class="badge"><span aria-hidden="true">✓</span>{t.kicker}</p>

    <h1 data-when="done">
      {t.titleDone[0]}<br /><span class="hot">{t.titleDone[1]}</span>
    </h1>
    <h1 data-when="later" hidden>
      {t.titleLater[0]}<br /><span class="hot">{t.titleLater[1]}</span>
    </h1>
    <p class="lede" data-when="done">{t.leadDone}</p>
    <p class="lede" data-when="later" hidden>{t.leadLater}</p>

    <a href={flow9.onboardingPath} class="go" data-when="later" hidden data-track="thanks_finish_click">{t.finish}</a>

    <ol role="list" class="next">
      {
        t.next.map((n, i) => (
          <li>
            <span class="n">{i + 1}</span>
            <b>{n.t}</b>
            <span>{n.d}</span>
          </li>
        ))
      }
    </ol>

    <aside class="refer">
      <div>
        <h2>{t.referTitle}</h2>
        <p>{t.referLine}</p>
      </div>
      <button type="button" class="copy" data-copy data-url="/automotive/v9">{t.referCta}</button>
    </aside>
  </main>
</BaseLayout>

<script>
  import { track } from '../../../scripts/analytics';
  const later = new URLSearchParams(location.search).get('later') === '1';
  document.querySelectorAll<HTMLElement>('[data-when]').forEach((el) => (el.hidden = (el.dataset.when === 'later') !== later));
  track('thank_you_view', { later });

  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  btn?.addEventListener('click', async () => {
    const url = location.origin + (btn.dataset.url || '/');
    try {
      await navigator.clipboard.writeText(url);
      btn.textContent = 'Link copied';
    } catch {
      btn.textContent = url;
    }
    track('referral_copy');
  });
</script>

<style>
  .top {
    padding: 20px var(--gutter);
    max-width: calc(980px + var(--gutter) * 2);
    margin-inline: auto;
  }
  .logo {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 1.25rem;
    color: #fff;
    text-decoration: none;
  }
  .logo span {
    color: var(--hot);
    margin-left: 3px;
  }
  .wrap {
    max-width: calc(980px + var(--gutter) * 2);
    margin-inline: auto;
    padding: clamp(1.5rem, 1rem + 3vw, 4rem) var(--gutter) clamp(4rem, 3rem + 4vw, 7rem);
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(61, 220, 151, 0.14);
    border: 1px solid rgba(61, 220, 151, 0.5);
    color: #9fe8c8;
    font-size: 0.8125rem;
    font-weight: 800;
  }
  h1 {
    font-size: clamp(2.4rem, 1.2rem + 5vw, 5.6rem);
    letter-spacing: -0.055em;
  }
  h1[hidden],
  [hidden] {
    display: none !important;
  }
  .next {
    margin: var(--s-5) 0 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 2px solid rgba(255, 255, 255, 0.2);
  }
  .next li {
    position: relative;
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 26px 20px 0 0;
  }
  .n {
    position: absolute;
    top: -15px;
    left: 0;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--hot);
    color: #fff;
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 0.8125rem;
  }
  .next b {
    font-family: var(--f-head);
    font-size: 1.3rem;
    letter-spacing: -0.03em;
  }
  .next li > span:last-child {
    color: var(--fog);
    line-height: 1.5;
  }
  .refer {
    margin-top: var(--s-6);
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-5);
    flex-wrap: wrap;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border-radius: 24px;
    background: #d8ff3e;
    color: #0b1016;
  }
  .refer h2 {
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem);
    letter-spacing: -0.04em;
  }
  .refer p {
    margin-top: 4px;
    font-weight: 600;
  }
  .copy {
    min-height: 52px;
    padding: 0 24px;
    border: 0;
    border-radius: 999px;
    background: #0b1016;
    color: #fff;
    font-family: var(--f-head);
    font-weight: 700;
    cursor: pointer;
  }
  @media (max-width: 800px) {
    .next {
      grid-template-columns: 1fr;
      border-top: 0;
      border-left: 2px solid rgba(255, 255, 255, 0.2);
      row-gap: var(--s-5);
    }
    .next li {
      padding: 0 0 0 28px;
    }
    .n {
      top: 0;
      left: -15px;
    }
    .copy {
      width: 100%;
    }
  }
</style>
