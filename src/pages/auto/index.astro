---
/**
 * Checkout page for auto shops: get.cnvrtx.com/auto
 * (offerV9.checkoutPath; the next industry gets its own, for example /roofing).
 *
 * One job: take the payment. No menu and no other offers. Every "Start Annual" and
 * "Start Monthly" button and the reserve form lead here.
 *
 * In the address:
 *   ?plan=annual | monthly   which way of paying is selected (annual when left out)
 *   ?offer=kit               the leaving offer: monthly with the lower Launch Kit
 *
 * The payment itself is the GHL order form, shown in a frame. Its links are set in
 * src/config/offerV9.ts (checkout, and exitOffer.checkout). Until a link is set the panel
 * says checkout is being connected. After payment GHL sends the buyer to /onboarding?paid=1.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { checkout9 as c } from '../../content/automotiveCopyV9';
import { offerV9 as cfg, featuredPlan as plan, fillOffer } from '../../config/offerV9';
import '../../styles/v9.css';

const money = (n: number) => '$' + n.toLocaleString('en-US');
const offerKit = cfg.exitOffer.launchKit;
const fill = (t: string) =>
  fillOffer(t)
    .replaceAll('{annual}', money(plan.annual))
    .replaceAll('{monthly}', money(plan.monthly))
    .replaceAll('{kit}', money(plan.launchKit))
    .replaceAll('{offerKit}', money(offerKit))
    .replaceAll('{site}', money(cfg.website.addOn));
// order form links; '' until they are set and checkout is switched on
const live = cfg.checkoutLive;
const links = {
  annual: live ? cfg.checkout[plan.id].annual : '',
  monthly: live ? cfg.checkout[plan.id].monthly : '',
  offer: live && cfg.exitOffer.enabled ? cfg.exitOffer.checkout : '',
};
const dueMonthly = plan.monthly + plan.launchKit;
const dueOffer = plan.monthly + offerKit;
const dev = import.meta.env.DEV;
---

<BaseLayout title="Checkout | CNVRT X Front Office for Auto Shops" description="Start CNVRT X Front Office: pay annually or monthly. Secure checkout." canonical={new URL(cfg.checkoutPath, Astro.site).href} noindex={true} bodyClass="v9" themeColor="#070B10">
  <header class="top">
    <a href="/" class="logo" aria-label="CNVRT X home page">CNVRT<span>✕</span></a>
    <span class="secure">
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="4" y="9" width="12" height="8" rx="2" stroke="currentColor" stroke-width="1.800"></rect><path d="M7 9V6.500a3 3 0 0 1 6 0V9" stroke="currentColor" stroke-width="1.800" stroke-linecap="round"></path></svg>
      {c.secure}
    </span>
    <a href="/#pricing" class="back">{c.back}</a>
  </header>

  <main id="main" class="wrap" data-co data-offer-on={cfg.exitOffer.enabled ? '' : undefined}>
    <header class="head">
      <h1>
        {c.title[0]} <span class="hot">{c.title[1]}</span>
      </h1>
      <p class="lede">{fill(c.sub)}</p>
    </header>

    <div class="grid">
      <!-- left: what they are buying -->
      <section class="sum" aria-label="Your order">
        <div class="ivl" role="radiogroup" aria-label={c.switchLabel}>
          <label>
            <input type="radio" name="plan" value="annual" checked />
            <span>
              {c.annual.name} <em>{c.annual.tag}</em>
            </span>
          </label>
          <label>
            <input type="radio" name="plan" value="monthly" />
            <span>{c.monthly.name}</span>
          </label>
        </div>

        <div class="card" data-when="annual">
          <p class="price">
            <b>{fill(c.annual.price)}</b>
            <span>{c.annual.per}</span>
          </p>
          <ul role="list" class="lines">
            {c.annual.lines.map((l) => <li>{fill(l)}</li>)}
          </ul>
          <p class="due">
            <span>{c.annual.dueLabel}</span>
            <b>{fill(c.annual.due)}</b>
          </p>
        </div>

        <div class="card" data-when="monthly" hidden>
          <p class="price">
            <b>{fill(c.monthly.price)}</b>
            <span>{c.monthly.per}</span>
          </p>
          <ul role="list" class="lines">
            <li>{fill(c.monthly.lines[0])}</li>
            <li data-kit="regular">{fill(c.monthly.lines[1])}</li>
            <li data-kit="offer" hidden>
              {fill(c.monthly.offerLine)} <em class="tag">{c.monthly.offerTag}</em>
            </li>
          </ul>
          <p class="due">
            <span>{c.monthly.dueLabel}</span>
            <b data-kit="regular">{money(dueMonthly)}</b>
            <b data-kit="offer" hidden>
              {money(dueOffer)} <s>{money(dueMonthly)}</s>
            </b>
          </p>
          <p class="due-n">{fill(c.monthly.dueNote)}</p>
        </div>

        <div class="more">
          <p class="m-h">{c.includesTitle}</p>
          <ul role="list" class="ticks">
            {c.includes.map((x) => <li>{x}</li>)}
          </ul>
          <p class="m-h">{c.nextTitle}</p>
          <ol role="list" class="steps">
            {c.next.map((x, i) => (
              <li>
                <span>{i + 1}</span>
                {x}
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- right: the payment -->
      <section class="pay" aria-labelledby="pay-title">
        <h2 id="pay-title">{c.payTitle}</h2>
        <div class="frame" data-frame data-embed={cfg.checkoutEmbed ? '' : undefined} data-annual={links.annual} data-monthly={links.monthly} data-offer={links.offer}>
          <iframe title="Secure payment form" data-pay hidden></iframe>
          <div class="open" data-open hidden>
            <a class="go" data-pay-link href="#" data-track="checkout_continue_click">
              {c.payCta}
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 5.500 15.500 10 11 14.500" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
            <p>{c.payNote}</p>
          </div>
          <div class="closed" data-closed>
            <p class="c-t">{c.notOpen.title}</p>
            <p>{c.notOpen.body}</p>
            {dev && <p class="preview">{c.preview}</p>}
          </div>
        </div>
        <ul role="list" class="promises">
          {c.promises.map((x) => <li>{x}</li>)}
        </ul>
        <p class="fine">
          {fill(c.fine)}
          <a href={cfg.legal.terms}>Terms of Service</a> · <a href={cfg.legal.cancellation}>Cancellation Policy</a> · <a href={cfg.legal.privacy}>Privacy Policy</a>
        </p>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { track } from '../../scripts/analytics';
  import { captureAttribution, withAttribution } from '../../scripts/attribution';

  const root = document.querySelector<HTMLElement>('[data-co]');
  if (root) {
    const q = new URLSearchParams(location.search);
    const offer = q.get('offer') === 'kit' && root.hasAttribute('data-offer-on');
    // the leaving offer is a monthly offer, so it selects monthly
    let plan = offer || q.get('plan') === 'monthly' ? 'monthly' : 'annual';
    const frame = root.querySelector<HTMLElement>('[data-frame]')!;
    const pay = root.querySelector<HTMLIFrameElement>('[data-pay]')!;
    const closed = root.querySelector<HTMLElement>('[data-closed]')!;
    const open = root.querySelector<HTMLElement>('[data-open]')!;
    const payLink = root.querySelector<HTMLAnchorElement>('[data-pay-link]')!;
    const embed = frame.hasAttribute('data-embed');
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[name="plan"]')];
    const attr = captureAttribution();
    if (attr.rep) root.dataset.rep = attr.rep;

    const show = () => {
      radios.forEach((r) => (r.checked = r.value === plan));
      root.querySelectorAll<HTMLElement>('[data-when]').forEach((el) => (el.hidden = el.dataset.when !== plan));
      const useOffer = offer && plan === 'monthly';
      root.querySelectorAll<HTMLElement>('[data-kit]').forEach((el) => (el.hidden = (el.dataset.kit === 'offer') !== useOffer));
      // the order form for this choice; the leaving offer has its own, because the amount differs
      // the rep code (?rep=) and ad details travel with it, so GHL can credit the sale
      const raw = (useOffer ? frame.dataset.offer : '') || frame.dataset[plan] || '';
      const url = raw ? withAttribution(raw, attr) : '';
      closed.hidden = Boolean(url);
      // shown in a frame, or opened with a button: one or the other
      pay.hidden = !(url && embed);
      open.hidden = !(url && !embed);
      if (url && embed) {
        if (pay.getAttribute('src') !== url) pay.src = url;
      } else pay.removeAttribute('src');
      if (url && !embed) payLink.href = url;
    };
    radios.forEach((r) =>
      r.addEventListener('change', () => {
        plan = r.value;
        track('checkout_plan_switch', { plan });
        show();
      }),
    );
    show();
    track('checkout_view', { plan, offer, rep: attr.rep || '' });
  }
</script>

<style>
  .top {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    max-width: calc(1180px + var(--gutter) * 2);
    margin-inline: auto;
    padding: 20px var(--gutter);
  }
  .logo {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 1.25rem;
    color: #fff;
    text-decoration: none;
  }
  .logo span {
    color: var(--hot);
    margin-left: 3px;
  }
  .secure {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #d8ff3e;
  }
  .secure svg {
    width: 18px;
    height: 18px;
  }
  .back {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    padding: 0 16px;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .back:hover {
    border-color: #fff;
  }
  .wrap {
    max-width: calc(1180px + var(--gutter) * 2);
    margin-inline: auto;
    padding: clamp(0.5rem, 0.25rem + 1vw, 1.5rem) var(--gutter) clamp(3rem, 2rem + 4vw, 6rem);
    color: #eef3f7;
  }
  .head {
    display: grid;
    gap: 10px;
    margin-bottom: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
  }
  h1 {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: clamp(1.9rem, 1.3rem + 2.6vw, 3.4rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
  }
  .lede {
    max-width: 60ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    line-height: 1.5;
    color: var(--fog);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    align-items: start;
  }
  .sum,
  .pay {
    display: grid;
    gap: 16px;
    padding: clamp(1.1rem, 0.9rem + 1.2vw, 2rem);
    border-radius: 26px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
  }
  /* ---------- annual / monthly ---------- */
  .ivl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    padding: 5px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
  }
  .ivl label {
    position: relative;
    cursor: pointer;
  }
  .ivl input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .ivl span {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2px 8px;
    min-height: 46px;
    padding: 4px 10px;
    border-radius: 999px;
    font-family: var(--f-head);
    font-weight: 700;
    text-align: center;
  }
  .ivl em {
    font-family: var(--f-text);
    font-style: normal;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #d8ff3e;
  }
  .ivl input:checked + span {
    background: #d8ff3e;
    color: #0b1016;
  }
  .ivl input:checked + span em {
    color: #0b1016;
  }
  .ivl input:focus-visible + span {
    outline: 3px solid #7cc4ff;
    outline-offset: 2px;
  }
  /* ---------- the order ---------- */
  .card {
    display: grid;
    gap: 12px;
  }
  .card[hidden],
  [data-kit][hidden] {
    display: none;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .price b {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: clamp(2.6rem, 2rem + 3vw, 4.2rem);
    letter-spacing: -0.06em;
    line-height: 1;
    color: #fff;
  }
  .price span {
    font-weight: 700;
    color: var(--fog);
  }
  .lines {
    margin: 0;
    display: grid;
    gap: 6px;
  }
  .lines li {
    line-height: 1.4;
    color: #dbe4ec;
  }
  .tag {
    display: inline-block;
    margin-left: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    background: #d8ff3e;
    color: #0b1016;
    font-style: normal;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .due {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    font-weight: 700;
  }
  .due b {
    font-family: var(--f-head);
    font-size: 1.6rem;
    letter-spacing: -0.03em;
    color: #d8ff3e;
  }
  .due s {
    font-size: 1rem;
    font-weight: 600;
    color: var(--fog-2);
  }
  .due-n {
    font-size: 0.8125rem;
    color: var(--fog);
  }
  .more {
    display: grid;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .m-h {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #d8ff3e;
  }
  .ticks,
  .steps,
  .promises {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .ticks li,
  .promises li {
    position: relative;
    padding-left: 26px;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .ticks li::before,
  .promises li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0.32em;
    width: 11px;
    height: 6px;
    border-left: 2.5px solid #d8ff3e;
    border-bottom: 2.5px solid #d8ff3e;
    transform: rotate(-45deg);
  }
  .steps li {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .steps span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 0.8125rem;
  }
  /* ---------- the payment ---------- */
  .pay h2 {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: -0.03em;
  }
  .frame {
    border-radius: 18px;
    overflow: hidden;
    background: #fff;
  }
  .frame iframe {
    display: block;
    width: 100%;
    min-height: 720px;
    border: 0;
  }
  .frame iframe[hidden],
  .closed[hidden],
  .open[hidden] {
    display: none;
  }
  .open {
    display: grid;
    gap: 12px;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    background: #f4f2ec;
    color: #0b1016;
  }
  .open .go {
    width: 100%;
  }
  .open p {
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .closed {
    display: grid;
    gap: 8px;
    align-content: center;
    min-height: 260px;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    background: #f4f2ec;
    color: #0b1016;
  }
  .c-t {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
  }
  .preview {
    margin-top: 6px;
    padding: 8px 12px;
    border-radius: 10px;
    border: 1px dashed #b07a00;
    font-size: 0.8125rem;
    color: #6b4a00;
  }
  .fine {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--fog-2);
  }
  .fine a {
    color: var(--fog);
    text-underline-offset: 3px;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .top {
      grid-template-columns: auto 1fr;
    }
    .secure {
      justify-self: end;
    }
    .back {
      display: none;
    }
    .frame iframe {
      min-height: 820px;
    }
  }
</style>
