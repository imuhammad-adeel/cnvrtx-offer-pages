---
/**
 * Checkout page for auto shops: get.cnvrtx.com/auto
 * (offerV9.checkoutPath; the next industry gets its own, for example /roofing).
 *
 * One job: take the payment. No menu and no other offers. Every "Start Annual" and
 * "Start Monthly" button and the reserve form lead here.
 *
 * In the address:
 *   ?plan=annual | monthly   which way of paying is selected (annual when left out)
 *   ?offer=kit               the leaving offer: monthly with the lower Launch Kit
 *
 * This page is the order summary AND the reserve form. It works on its own: the buyer picks
 * annual or monthly, gives their details here, the form is sent to GHL first (that starts
 * abandoned-checkout recovery), and then the matching checkout page opens (/checkout/...,
 * built in AI Studio). After payment the buyer lands on /thank-you?paid=1.
 * The sales pages have the same form at #start; both post the same fields to the same webhook.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Included9 from '../../components/automotive-v9/Included9.astro';
import { checkout9 as c, start9 } from '../../content/automotiveCopyV9';
import { automotiveOffer as o, ATTRIBUTION_PARAMS } from '../../config/automotiveOffer';
import { offerV9 as cfg, featuredPlan as plan, fillOffer } from '../../config/offerV9';
import '../../styles/v9.css';

const money = (n: number) => '$' + n.toLocaleString('en-US');
const offerKit = cfg.exitOffer.launchKit;
const fill = (t: string) =>
  fillOffer(t)
    .replaceAll('{annual}', money(plan.annual))
    .replaceAll('{monthly}', money(plan.monthly))
    .replaceAll('{kit}', money(plan.launchKit))
    .replaceAll('{offerKit}', money(offerKit))
    .replaceAll('{site}', money(cfg.website.addOn));
// the Launch Kit is optional on Monthly (owner decision 2026-11-25): due today is the first month only
const dueMonthly = plan.monthly;
const dueOffer = plan.monthly + offerKit;
const dueWas = plan.monthly + plan.launchKit;
const dev = import.meta.env.DEV;
---

<BaseLayout title="Checkout | CNVRT X Front Office for Auto Shops" description="Start CNVRT X Front Office: pay annually or monthly. Secure checkout." canonical={new URL(cfg.checkoutPath, Astro.site).href} noindex={true} bodyClass="v9" themeColor="#070B10">
  <header class="top">
    <a href="/" class="logo" aria-label="CNVRT X home page">CNVRT<span>✕</span></a>
    <span class="secure">
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="4" y="9" width="12" height="8" rx="2" stroke="currentColor" stroke-width="1.800"></rect><path d="M7 9V6.500a3 3 0 0 1 6 0V9" stroke="currentColor" stroke-width="1.800" stroke-linecap="round"></path></svg>
      {c.secure}
    </span>
    <a href="/#pricing" class="back">{c.back}</a>
  </header>

  <main id="main" class="wrap" data-co data-offer-on={cfg.exitOffer.enabled ? '' : undefined}>
    <header class="head">
      <h1>
        {c.title[0]} <span class="hot">{c.title[1]}</span>
      </h1>
      <p class="lede">{fill(c.sub)}</p>
    </header>

    <div class="grid">
      <!-- left: what they are buying -->
      <section class="sum" aria-label="Your order">
        <div class="ivl" role="radiogroup" aria-label={c.switchLabel}>
          <label>
            <input type="radio" name="plan" value="annual" checked />
            <span>
              {c.annual.name} <em>{c.annual.tag}</em>
            </span>
          </label>
          <label>
            <input type="radio" name="plan" value="monthly" />
            <span>{c.monthly.name}</span>
          </label>
        </div>

        <div class="card" data-when="annual">
          <p class="price">
            <b>{fill(c.annual.price)}</b>
            <span>{c.annual.per}</span>
          </p>
          <ul role="list" class="lines">
            {c.annual.lines.map((l) => <li>{fill(l)}</li>)}
          </ul>
          <p class="due">
            <span>{c.annual.dueLabel}</span>
            <b>{fill(c.annual.due)}</b>
          </p>
          <Included9 />
        </div>

        <div class="card" data-when="monthly" hidden>
          <p class="price">
            <b>{fill(c.monthly.price)}</b>
            <span>{c.monthly.per}</span>
          </p>
          <ul role="list" class="lines">
            <li>{fill(c.monthly.lines[0])}</li>
            <li data-kit="regular">{fill(c.monthly.lines[1])}</li>
            <li data-kit="offer" hidden>
              {fill(c.monthly.offerLine)} <em class="tag">{c.monthly.offerTag}</em>
            </li>
          </ul>
          <p class="due">
            <span>{c.monthly.dueLabel}</span>
            <b data-kit="regular">{money(dueMonthly)}</b>
            <b data-kit="offer" hidden>
              {money(dueOffer)} <s>{money(dueWas)}</s>
            </b>
          </p>
          <p class="due-n" data-kit="regular">{fill(c.monthly.dueNote)}</p>
          <p class="due-n" data-kit="offer" hidden>{fill(c.monthly.offerDueNote)}</p>
          <p class="kit-l" data-kit="regular">{c.monthly.kitLine}</p>
          <Included9 />
        </div>

        <div class="more">
          <p class="m-h">{c.includesTitle}</p>
          <ul role="list" class="ticks">
            {c.includes.map((x) => <li>{x}</li>)}
          </ul>
          <p class="m-h">{c.nextTitle}</p>
          <ol role="list" class="steps">
            {c.next.map((x, i) => (
              <li>
                <span>{i + 1}</span>
                {x}
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- right: the payment -->
      <section class="pay" aria-labelledby="pay-title">
        <h2 id="pay-title">{c.payTitle}</h2>
        <form
          class="rf"
          data-reserve
          action={o.endpoints.reserve || undefined}
          method="post"
          novalidate
          data-co-live={cfg.checkoutLive ? '' : undefined}
          data-co-annual={cfg.checkout[plan.id].annual}
          data-co-monthly={cfg.checkout[plan.id].monthly}
          data-co-kit={cfg.exitOffer.enabled ? cfg.exitOffer.checkout : ''}
          data-sending={c.form.sending}
          data-error={c.form.error}
        >
          <p class="rf-note">{c.form.note}</p>
          <div class="rf-two">
            <div class="fld">
              <label for="rf-first">{c.form.firstName}</label>
              <input id="rf-first" name="first_name" autocomplete="given-name" required />
            </div>
            <div class="fld">
              <label for="rf-biz">{c.form.business}</label>
              <input id="rf-biz" name="business_name" autocomplete="organization" required />
            </div>
          </div>
          <div class="rf-two">
            <div class="fld">
              <label for="rf-email">{c.form.email}</label>
              <input id="rf-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="fld">
              <label for="rf-phone">{c.form.phone}</label>
              <input id="rf-phone" name="phone" type="tel" autocomplete="tel" required />
            </div>
          </div>

          {/* same field names as the sales page's reserve form; see src/scripts/forms.ts */}
          <input type="hidden" name="billing_interval" value="annual" data-rf-interval />
          <input type="hidden" name="plan_interest" value={plan.role} />
          <input type="hidden" name="landing_page" value="" data-rf-landing />
          <input type="hidden" name="calc_estimate" value="" />
          {ATTRIBUTION_PARAMS.map((x) => <input type="hidden" name={x} value="" data-attr-field />)}
          {/* honeypot: people never see or fill this; a bot that does is dropped without sending */}
          <p class="hp" aria-hidden="true">
            <label>
              Leave this field empty
              <input type="text" name="company_website" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <fieldset class="rf-sms">
            <legend>{c.form.smsLegend}</legend>
            <label>
              <input type="checkbox" name="sms_account_consent" value="yes" />
              <span>{start9.sms.account}</span>
            </label>
            <label>
              <input type="checkbox" name="sms_marketing_consent" value="yes" />
              <span>{start9.sms.marketing}</span>
            </label>
          </fieldset>

          <button type="submit" class="go">
            {cfg.checkoutLive ? c.form.submit : c.form.submitClosed}
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 5.500 15.500 10 11 14.500" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </button>
          <p class="rf-status" role="status" aria-live="polite" data-rf-status></p>
        </form>
        <div class="rf-ok" data-rf-ok hidden tabindex="-1">
          <p class="c-t">{c.form.closed.title}</p>
          <p>{c.form.closed.body}</p>
        </div>
        <ul role="list" class="promises">
          {c.promises.map((x) => <li>{x}</li>)}
        </ul>
        <p class="fine">
          {fill(c.fine)}
          <a href={cfg.legal.terms}>Terms of Service</a> · <a href={cfg.legal.cancellation}>Cancellation Policy</a> · <a href={cfg.legal.privacy}>Privacy Policy</a>
        </p>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { track } from '../../scripts/analytics';
  import { captureAttribution } from '../../scripts/attribution';
  import { isBot, send, saveBuyer, FIELDS } from '../../scripts/forms';

  const root = document.querySelector<HTMLElement>('[data-co]');
  if (root) {
    const q = new URLSearchParams(location.search);
    const offer = q.get('offer') === 'kit' && root.hasAttribute('data-offer-on');
    // the leaving offer is a monthly offer, so it selects monthly
    let plan = offer || q.get('plan') === 'monthly' ? 'monthly' : 'annual';
    const form = root.querySelector<HTMLFormElement>('[data-reserve]')!;
    const intervalField = form.querySelector<HTMLInputElement>('[data-rf-interval]')!;
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[name="plan"]')];
    const attr = captureAttribution();

    const show = () => {
      radios.forEach((r) => (r.checked = r.value === plan));
      root.querySelectorAll<HTMLElement>('[data-when]').forEach((el) => (el.hidden = el.dataset.when !== plan));
      const useOffer = offer && plan === 'monthly';
      root.querySelectorAll<HTMLElement>('[data-kit]').forEach((el) => (el.hidden = (el.dataset.kit === 'offer') !== useOffer));
      intervalField.value = plan;
    };
    radios.forEach((r) =>
      r.addEventListener('change', () => {
        plan = r.value;
        track('checkout_plan_switch', { plan });
        show();
      }),
    );
    show();
    track('checkout_view', { plan, offer, rep: attr.rep || '' });

    // ---- the reserve form: details to GHL first, then the matching checkout page ----
    const landing = form.querySelector<HTMLInputElement>('[data-rf-landing]');
    if (landing) landing.value = location.origin + location.pathname;
    // attribution fields are filled by page.ts on load; fill again in case this ran first
    form.querySelectorAll<HTMLInputElement>('input[data-attr-field]').forEach((f) => {
      const v = (attr as Record<string, string | undefined>)[f.name];
      if (v) f.value = v;
    });
    const status = form.querySelector<HTMLElement>('[data-rf-status]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      let first: HTMLInputElement | null = null;
      form.querySelectorAll<HTMLInputElement>('[required]').forEach((f) => {
        const bad = !f.value.trim() || (f.type === 'email' && !/^\S+@\S+\.\S+$/.test(f.value.trim()));
        f.toggleAttribute('aria-invalid', bad);
        if (bad && !first) first = f;
      });
      if (first) {
        (first as HTMLInputElement).focus();
        return;
      }
      const data = new FormData(form);
      track('start_form_submit', { interval: plan, configured: Boolean(form.getAttribute('action')), page: 'auto' });
      // the buyer's details go along in this browser's storage, never in the address
      const next = () => {
        saveBuyer({ email: String(data.get('email') || ''), first_name: String(data.get('first_name') || ''), phone: String(data.get('phone') || '') });
        const useOffer = offer && plan === 'monthly';
        const page = (useOffer && form.dataset.coKit) || (plan === 'monthly' ? form.dataset.coMonthly : form.dataset.coAnnual);
        if (form.hasAttribute('data-co-live') && page) {
          location.href = page;
          return;
        }
        form.hidden = true;
        const ok = root.querySelector<HTMLElement>('[data-rf-ok]')!;
        ok.hidden = false;
        ok.focus();
      };
      if (isBot(form) || !form.getAttribute('action')) return next();
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      btn.disabled = true;
      status.textContent = form.dataset.sending || '';
      try {
        await send(form.action, form, FIELDS.reserve);
        next();
      } catch {
        status.textContent = form.dataset.error || '';
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .top {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    max-width: calc(1180px + var(--gutter) * 2);
    margin-inline: auto;
    padding: 20px var(--gutter);
  }
  .logo {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 1.25rem;
    color: #fff;
    text-decoration: none;
  }
  .logo span {
    color: var(--hot);
    margin-left: 3px;
  }
  .secure {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #d8ff3e;
  }
  .secure svg {
    width: 18px;
    height: 18px;
  }
  .back {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    padding: 0 16px;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .back:hover {
    border-color: #fff;
  }
  .wrap {
    max-width: calc(1180px + var(--gutter) * 2);
    margin-inline: auto;
    padding: clamp(0.5rem, 0.25rem + 1vw, 1.5rem) var(--gutter) clamp(3rem, 2rem + 4vw, 6rem);
    color: #eef3f7;
  }
  .head {
    display: grid;
    gap: 10px;
    margin-bottom: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
  }
  h1 {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: clamp(1.9rem, 1.3rem + 2.6vw, 3.4rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
  }
  .lede {
    max-width: 60ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    line-height: 1.5;
    color: var(--fog);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    align-items: start;
  }
  .sum,
  .pay {
    display: grid;
    gap: 16px;
    padding: clamp(1.1rem, 0.9rem + 1.2vw, 2rem);
    border-radius: 26px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
  }
  /* ---------- annual / monthly ---------- */
  .ivl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    padding: 5px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
  }
  .ivl label {
    position: relative;
    cursor: pointer;
  }
  .ivl input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .ivl span {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2px 8px;
    min-height: 46px;
    padding: 4px 10px;
    border-radius: 999px;
    font-family: var(--f-head);
    font-weight: 700;
    text-align: center;
  }
  .ivl em {
    font-family: var(--f-text);
    font-style: normal;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #d8ff3e;
  }
  .ivl input:checked + span {
    background: #d8ff3e;
    color: #0b1016;
  }
  .ivl input:checked + span em {
    color: #0b1016;
  }
  .ivl input:focus-visible + span {
    outline: 3px solid #7cc4ff;
    outline-offset: 2px;
  }
  /* ---------- the order ---------- */
  .card {
    display: grid;
    gap: 12px;
  }
  .card[hidden],
  [data-kit][hidden] {
    display: none;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .price b {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: clamp(2.6rem, 2rem + 3vw, 4.2rem);
    letter-spacing: -0.06em;
    line-height: 1;
    color: #fff;
  }
  .price span {
    font-weight: 700;
    color: var(--fog);
  }
  .lines {
    margin: 0;
    display: grid;
    gap: 6px;
  }
  .lines li {
    line-height: 1.4;
    color: #dbe4ec;
  }
  .tag {
    display: inline-block;
    margin-left: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    background: #d8ff3e;
    color: #0b1016;
    font-style: normal;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .due {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    font-weight: 700;
  }
  .due b {
    font-family: var(--f-head);
    font-size: 1.6rem;
    letter-spacing: -0.03em;
    color: #d8ff3e;
  }
  .due s {
    font-size: 1rem;
    font-weight: 600;
    color: var(--fog-2);
  }
  .due-n {
    font-size: 0.8125rem;
    color: var(--fog);
  }
  .kit-l {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.4;
    color: #d8ff3e;
  }
  .more {
    display: grid;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .m-h {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #d8ff3e;
  }
  .ticks,
  .steps,
  .promises {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .ticks li,
  .promises li {
    position: relative;
    padding-left: 26px;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .ticks li::before,
  .promises li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0.32em;
    width: 11px;
    height: 6px;
    border-left: 2.5px solid #d8ff3e;
    border-bottom: 2.5px solid #d8ff3e;
    transform: rotate(-45deg);
  }
  .steps li {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .steps span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 0.8125rem;
  }
  /* ---------- the payment ---------- */
  .pay h2 {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: -0.03em;
  }
  /* ---------- the reserve form ---------- */
  .rf {
    display: grid;
    gap: 14px;
  }
  .rf[hidden],
  .rf-ok[hidden] {
    display: none;
  }
  .rf-note {
    font-size: 0.9375rem;
    color: var(--fog);
  }
  .rf-two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .fld {
    display: grid;
    gap: 6px;
  }
  .fld label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #c5d0da;
  }
  .fld input {
    width: 100%;
    min-height: 50px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font: inherit;
  }
  .fld input:focus-visible {
    outline: 3px solid #7cc4ff;
    outline-offset: 1px;
  }
  .fld input[aria-invalid] {
    border-color: #ff8f7a;
  }
  .rf-sms {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 12px 14px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
  }
  .rf-sms legend {
    padding: 0 6px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fog);
  }
  .rf-sms label {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: #dbe4ec;
    cursor: pointer;
  }
  .rf-sms input {
    width: 20px;
    height: 20px;
    margin-top: 1px;
    accent-color: #d8ff3e;
  }
  .rf .go {
    width: 100%;
  }
  .rf-status {
    font-size: 0.875rem;
    font-weight: 700;
    color: #ffb4a6;
  }
  .rf-status:empty {
    display: none;
  }
  .rf-ok {
    display: grid;
    gap: 8px;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    border-radius: 18px;
    background: #f4f2ec;
    color: #0b1016;
  }
  .c-t {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
  }
  .fine {
