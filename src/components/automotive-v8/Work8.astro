---
import { work8 as w } from '../../content/automotiveCopyV8';
---

<section class="scene work pearl" aria-labelledby="work-title">
  <div class="container grid">
    <div class="left">
      <p class="kicker" data-reveal>{w.kicker}</p>
      <h2 id="work-title" class="t-lg" data-reveal>
        {w.title[0]} <span class="hot">{w.title[1]}</span>
      </h2>
      <p class="lede">{w.lead}</p>

      <div class="quotes">
        <p class="q q-sw"><span>{w.quotes.software.label}</span>“{w.quotes.software.q}”</p>
        <p class="q q-cx"><span>{w.quotes.cnvrtx.label}</span>“{w.quotes.cnvrtx.q}”</p>
      </div>

      <div class="part" data-spot>
        <span class="p-l">{w.yourPart.label}</span>
        <p class="p-b">{w.yourPart.big}</p>
        <p class="p-d">{w.yourPart.line}</p>
      </div>
    </div>

    <div class="table" role="table" aria-label="Who does the work" data-work8>
      <div class="tr th" role="row">
        <span role="columnheader">{w.colTask}</span>
        <span role="columnheader">{w.colYou}</span>
        <span role="columnheader" class="us-h">{w.colUs}</span>
      </div>
      {
        w.rows.map((r, i) => (
          <div class="tr" role="row" style={`--i:${i}`}>
            <span role="cell" class="task">{r}</span>
            <span role="cell" class="you">{w.you}</span>
            <span role="cell" class="us"><i aria-hidden="true">✓</i>{w.us}</span>
          </div>
        ))
      }
      <div class="tr tot" role="row">
        <span role="cell" class="task">Jobs on your plate</span>
        <span role="cell" class="you"><b>{w.rows.length}</b></span>
        <span role="cell" class="us"><b>0</b></span>
      </div>
    </div>
  </div>
</section>

<script>
  // Each row ticks as it scrolls into view: "You" is crossed out, "We do it" fills in.
  const t = document.querySelector<HTMLElement>('[data-work8]');
  if (t) {
    const rows = [...t.querySelectorAll<HTMLElement>('.tr:not(.th)')];
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      rows.forEach((r) => r.setAttribute('data-on', ''));
    } else {
      const io = new IntersectionObserver(
        (es) =>
          es.forEach((e) => {
            if (e.isIntersecting) {
              e.target.setAttribute('data-on', '');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -32% 0px', threshold: 0.6 },
      );
      rows.forEach((r) => io.observe(r));
    }
  }
</script>

<style>
  .work {
    background: var(--pearl-2);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .left {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .quotes {
    display: grid;
    gap: 8px;
    width: 100%;
  }
  .q {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
    align-items: center;
    padding: 12px 16px;
    border-radius: 14px;
    font-family: var(--f-head);
    font-weight: 700;
    font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.4rem);
    letter-spacing: -0.03em;
  }
  .q span {
    font-family: var(--f-text);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .q-sw {
    border: 1.5px dashed rgba(11, 16, 22, 0.3);
    color: var(--ink-3);
  }
  .q-cx {
    background: var(--ink);
    color: #fff;
  }
  .q-cx span {
    color: #d8ff3e;
  }
  .part {
    display: grid;
    gap: 4px;
    width: 100%;
    padding: 18px 20px;
    border-radius: 18px;
    background: #d8ff3e;
    color: var(--ink);
    transition: box-shadow 300ms;
  }
  .p-l {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .p-b {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.8rem);
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .p-d {
    font-weight: 600;
  }

  .table {
    border-radius: 24px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 40px 80px -40px rgba(11, 16, 22, 0.5);
    border: 1px solid rgba(11, 16, 22, 0.08);
  }
  .tr {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.7fr) minmax(0, 0.9fr);
    align-items: stretch;
    border-top: 1px solid rgba(11, 16, 22, 0.08);
  }
  .tr > span {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 16px 18px;
  }
  .th {
    border-top: 0;
    background: var(--ink);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .us-h {
    background: var(--hot);
  }
  .task {
    font-weight: 700;
  }
  .you {
    font-family: var(--f-head);
    font-weight: 800;
    color: #9aa3ab;
    background: #f4f4f1;
  }
  .us {
    font-family: var(--f-head);
    font-weight: 800;
    background: #fafaf7;
    color: var(--ink);
  }
  .us i {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #d8ff3e;
    color: var(--ink);
    font-style: normal;
    font-size: 0.75rem;
    transform: scale(0);
    transition: transform 420ms cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .tr .us,
  .tr .you,
  .tr .task {
    transition:
      background-color 400ms,
      color 400ms,
      opacity 400ms;
  }
  .tr:not(.th):not([data-on]) .us {
    color: #b9b0aa;
  }
  .tr[data-on] .us i {
    transform: scale(1);
    animation: beat 2.6s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * 220ms + 700ms);
  }
  @keyframes beat {
    0%,
    70%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(216, 255, 62, 0.8);
    }
    82% {
      transform: scale(1.22);
      box-shadow: 0 0 0 8px rgba(216, 255, 62, 0);
    }
  }
  .tr[data-on] .us {
    background: #fff;
    color: var(--ink);
  }
  .tr[data-on] .you {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    opacity: 0.6;
  }
  .tot .you,
  .tot.tr[data-on] .you {
    text-decoration: none;
    opacity: 1;
  }
  .tot .us b,
  .tot .you b {
    transform: scale(0.6);
    opacity: 0.3;
    display: inline-block;
    transition:
      transform 500ms cubic-bezier(0.3, 1.6, 0.5, 1),
      opacity 400ms;
  }
  .tot[data-on] .us b,
  .tot[data-on] .you b {
    transform: scale(1);
    opacity: 1;
  }
  .tot > span {
    padding-block: 14px;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tot b {
    font-size: 2rem;
    letter-spacing: -0.04em;
  }
  .tot .you b {
    color: #d1483a;
  }
  .tot .us b {
    color: #0c8a5f;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .tr > span {
      padding: 12px 10px;
      font-size: 0.875rem;
    }
    .q {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .us i {
      transform: scale(1);
      transition: none;
      animation: none !important;
    }
  }
</style>
