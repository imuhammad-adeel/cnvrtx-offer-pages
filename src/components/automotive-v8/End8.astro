---
import { audit } from '../../content/automotiveCopy';
import { faq8 as q, start8 as e, nav8, offer8, math8, footer8 as ft } from '../../content/automotiveCopyV8';
import { automotiveOffer as o, ATTRIBUTION_PARAMS, resolveHref } from '../../config/automotiveOffer';

const mode = o.auditFormUrl ? o.auditFormMode : 'unconfigured';
const checkoutReady = Boolean(o.monthlyCheckoutUrl && o.annualCheckoutUrl);
const annualDest = resolveHref(o.annualCheckoutUrl, '#start');
const monthlyDest = resolveHref(o.monthlyCheckoutUrl, '#start');
const legal = [
  o.privacyUrl && { label: 'Privacy Policy', href: o.privacyUrl },
  o.termsUrl && { label: 'Terms', href: o.termsUrl },
  o.smsTermsUrl && { label: 'SMS Terms', href: o.smsTermsUrl },
].filter(Boolean) as { label: string; href: string }[];
const year = new Date().getFullYear();
const foundingDest = resolveHref(o.foundingCheckoutUrl, '#start');
const money = (n: number) => '$' + n.toLocaleString('en-US');
const regular = offer8.regularMonthly;
const mP = o.pricing.monthly.price;
const aP = o.pricing.annual.price;
const setupFee = o.pricing.monthly.setup;
// year-one saving against the upcoming price (annual and founding also skip the setup fee)
const planOpts = [
  { v: 'Annual', was: money(regular * 12), d: `${money(aP)} a year. Setup included.`, tag: 'Best value', href: annualDest.href, save: regular * 12 + setupFee - aP },
  { v: 'Monthly', was: money(regular), d: `${money(mP)} a month + ${money(setupFee)} setup.`, tag: '', href: monthlyDest.href, save: (regular - mP) * 12 },
  ...(o.foundingOfferActive
    ? [{ v: 'Founding (setup waived)', was: money(regular), d: `${money(mP)} a month. First 10 qualifying shops.`, tag: '', href: foundingDest.href, save: (regular - mP) * 12 + setupFee }]
    : []),
];
const md = math8.defaults;
const leakYear = Math.round(((md.missed * (52 / 12) * md.value) / md.oneIn) * 12);

---

<section class="scene faq pearl" id="faq" aria-labelledby="faq8-title">
  <div class="container fgrid">
    <header class="fhead" data-reveal>
      <p class="kicker">{q.kicker}</p>
      <h2 id="faq8-title" class="t-lg">{q.title}</h2>
    </header>
    <div class="qa" data-faq8>
      {
        q.items.map((f, i) => (
          <details>
            <summary>
              <span class="qn">{String(i + 1).padStart(2, '0')}</span>
              <span class="qt">{f.q}</span>
              <i aria-hidden="true" />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="scene audit pearl" id="start" aria-labelledby="start-title">
  <div class="container agrid">
    <div class="acopy">
      <p class="kicker" data-reveal>{e.kicker}</p>
      <h2 id="start-title" class="t-lg" data-reveal>
        <span class="rise"><span>{e.title[0]}</span></span>
        <span class="rise" style="--d:100ms"><span class="hot">{e.title[1]}</span></span>
      </h2>
      <p class="lede">{e.lead}</p>
      <ol role="list" class="steps">
        {
          e.steps.map((s, i) => (
            <li>
              <span>{i + 1}</span>
              <div>
                <b>{s.t}</b>
                <small>{s.d}</small>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="shell">
      {
        checkoutReady ? (
          <div class="picks" data-start-ready>
            <div class="fh">
              <h3>Start your build</h3>
              <span>No sales call</span>
            </div>
            <fieldset class="plans">
              <legend>Choose your plan</legend>
              {
                planOpts.map((pl, i) => (
                  <label>
                    <input type="radio" name="plan_interest" value={pl.v} checked={i === 0} data-href={pl.href} data-save={pl.save} />
                    <span class="pl">
                      <i aria-hidden="true" />
                      <span class="pl-m">
                        <b>
                          {pl.v}
                          {pl.tag && <em>{pl.tag}</em>}
                        </b>
                        <small><s>{pl.was}</s> {pl.d}</small>
                      </span>
                    </span>
                  </label>
                ))
              }
            </fieldset>
            <div class="gain" data-gain data-leak={leakYear}>
              <p class="g-h">On the table in your first year</p>
              <p class="g-r"><span>Price saved against the upcoming price</span><b data-g="save">{money(planOpts[0].save)}</b></p>
              <p class="g-r"><span>Leaks you can go after</span><b data-g="leak">{money(leakYear)}</b></p>
              <p class="g-t"><span>Up to</span><b data-g="total">{money(planOpts[0].save + leakYear)}</b></p>
              <p class="g-n">The leak figure comes from the calculator numbers. It is an estimate, not a promise.</p>
            </div>
            <a class="go" data-spot data-start-go data-checkout="Annual" href={annualDest.href} data-attr-link data-track="start_checkout_click">
              Continue to secure checkout
            </a>
            <p class="f-note">Next: secure checkout, then one short form. That is all you do.</p>
          </div>
        ) : (
          <form class="form" data-start8 data-mode={mode} action={o.auditFormUrl || undefined} method="post" novalidate>
            <div class="fh">
              <h3>{e.formTitle}</h3>
              <span>No sales call</span>
            </div>
            <fieldset class="plans">
              <legend>Choose your plan</legend>
              {
                planOpts.map((pl, i) => (
                  <label>
                    <input type="radio" name="plan_interest" value={pl.v} checked={i === 0} data-href={pl.href} data-save={pl.save} />
                    <span class="pl">
                      <i aria-hidden="true" />
                      <span class="pl-m">
                        <b>
                          {pl.v}
                          {pl.tag && <em>{pl.tag}</em>}
                        </b>
                        <small><s>{pl.was}</s> {pl.d}</small>
                      </span>
                    </span>
                  </label>
                ))
              }
            </fieldset>
            <div class="gain" data-gain data-leak={leakYear}>
              <p class="g-h">On the table in your first year</p>
              <p class="g-r"><span>Price saved against the upcoming price</span><b data-g="save">{money(planOpts[0].save)}</b></p>
              <p class="g-r"><span>Leaks you can go after</span><b data-g="leak">{money(leakYear)}</b></p>
              <p class="g-t"><span>Up to</span><b data-g="total">{money(planOpts[0].save + leakYear)}</b></p>
              <p class="g-n">The leak figure comes from the calculator numbers. It is an estimate, not a promise.</p>
            </div>
            <p class="f-note">{e.formNote}</p>
            <div class="two">
              <div class="fld">
                <label for="s8-first">First name</label>
                <input id="s8-first" name="first_name" autocomplete="given-name" required />
                <p class="err" data-err="s8-first">Please add your first name.</p>
              </div>
              <div class="fld">
                <label for="s8-biz">Business name</label>
                <input id="s8-biz" name="business_name" autocomplete="organization" required />
                <p class="err" data-err="s8-biz">Please add your business name.</p>
              </div>
            </div>
            <div class="two">
              <div class="fld">
                <label for="s8-email">Email</label>
                <input id="s8-email" name="email" type="email" autocomplete="email" required />
                <p class="err" data-err="s8-email">Please enter a valid email address.</p>
              </div>
              <div class="fld">
                <label for="s8-phone">Phone</label>
                <input id="s8-phone" name="phone" type="tel" autocomplete="tel" required />
                <p class="err" data-err="s8-phone">Please add a phone number.</p>
              </div>
            </div>

            <input type="hidden" name="landing_page" value="" data-landing />
            <input type="hidden" name="calc_estimate" value="" data-calc-field />
            {ATTRIBUTION_PARAMS.map((p) => <input type="hidden" name={p} value="" data-attr-field />)}

            <button type="submit" class="go send" data-spot>
              {e.submit}
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 5.500 15.500 10 11 14.500" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
            <p class="status" role="status" aria-live="polite" data-status></p>
            <p class="consent">
              {audit.consent.replace('about your audit', 'about your account')}
              {legal.map((l) => (
                <>
                  {' '}
                  <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
                </>
              ))}
            </p>
          </form>
        )
      }
      <div class="ok" hidden data-ok8 tabindex="-1">
        <span aria-hidden="true">✓</span>
        <h3>You are on the list.</h3>
        <p>Watch your inbox for your join link.</p>
      </div>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="container">
    <p class="big chrome">{e.footer}</p>

    <div class="f-grid">
      <div class="f-brand">
        <span class="logo">CNVRT<b>✕</b></span>
        <p>{ft.blurb}</p>
        <a href="#pricing" class="go go-sm" data-track="cta_click" data-track-location="footer">Get My System</a>
      </div>
      <nav aria-label="On this page">
        <p class="f-h">{ft.cols.page}</p>
        {nav8.links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="#faq">FAQ</a>
        <a href="#start">Get started</a>
      </nav>
      <nav aria-label="Legal">
        <p class="f-h">{ft.cols.legal}</p>
        {
          ft.legalLinks.map((label) => {
            const hit = legal.find((x) => x.label.toLowerCase().startsWith(label.toLowerCase().split(' ')[0]));
            return hit ? <a href={hit.href}>{label}</a> : <span class="soon" title="Page not published yet">{label}</span>;
          })
        }
      </nav>
      <div>
        <p class="f-h">{ft.cols.contact}</p>
        {o.contactUrl ? <a href={o.contactUrl}>Contact us</a> : <span class="soon" title="Contact link not set yet">Contact us</span>}
        <p class="f-co">{o.brand.legalName}</p>
      </div>
    </div>

    <div class="f-disc">
      {ft.disclaimers.map((d) => <p>{d}</p>)}
    </div>
    <p class="copy">© {year} {o.brand.legalName}. All rights reserved.</p>
  </div>
</footer>

<script>
  import { track } from '../../scripts/analytics';

  document.querySelectorAll<HTMLDetailsElement>('[data-faq8] details').forEach((d) =>
    d.addEventListener('toggle', () => {
      if (d.open) track('faq_open', { question: d.querySelector('.qt')?.textContent || '' });
    }),
  );

  const form = document.querySelector<HTMLFormElement>('[data-start8]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const ok = document.querySelector<HTMLElement>('[data-ok8]')!;
    const landing = form.querySelector<HTMLInputElement>('[data-landing]');
    if (landing) landing.value = location.origin + location.pathname;

    let started = false;
    form.addEventListener('focusin', () => {
      if (started) return;
      started = true;
      track('start_form_start');
    });

    const req = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]')];
    const check = (el: HTMLInputElement | HTMLSelectElement) => {
      const good = el.value.trim() !== '' && el.checkValidity();
      el.setAttribute('aria-invalid', String(!good));
      const err = form.querySelector<HTMLElement>(`[data-err="${el.id}"]`);
      if (err) {
        err.id = `${el.id}-err`;
        el.setAttribute('aria-describedby', err.id);
        err.classList.toggle('show', !good);
      }
      return good;
    };
    req.forEach((el) => {
      el.addEventListener('blur', () => el.value && check(el));
      el.addEventListener('input', () => el.getAttribute('aria-invalid') === 'true' && check(el));
    });

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const bad = req.filter((f) => !check(f));
      if (bad.length) {
        bad[0].focus();
        return;
      }
      const est = document.querySelector('[data-math8] [data-odo-sr]')?.textContent;
      const calcField = form.querySelector<HTMLInputElement>('[data-calc-field]');
      if (calcField && est) calcField.value = est;

      const mode = form.dataset.mode;
      const data = new FormData(form);
      track('start_form_submit', { plan_interest: String(data.get('plan_interest') || ''), configured: mode !== 'unconfigured' });
      if (mode === 'unconfigured') {
        status.textContent = 'This form is not connected yet. Set auditFormUrl (or the checkout URLs) in src/config/automotiveOffer.ts.';
        status.dataset.tone = 'warn';
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      btn.disabled = true;
      status.textContent = 'Sending…';
      try {
        await fetch(form.action, { method: 'POST', body: data, mode: 'no-cors' });
        form.hidden = true;
        ok.hidden = false;
        ok.focus();
      } catch {
        status.textContent = 'Something went wrong. Please try again.';
        status.dataset.tone = 'warn';
        btn.disabled = false;
      }
    });
  }

  // one path: the chosen plan drives the single button
  const setPlan = (v: string) => {
    const r = document.querySelector<HTMLInputElement>(`#start input[name="plan_interest"][value="${v}"]`);
    if (r) {
      r.checked = true;
      r.dispatchEvent(new Event('change', { bubbles: true }));
    }
  };
  window.addEventListener('cx:plan', (e) => setPlan((e as CustomEvent<string>).detail));
  const ready = document.querySelector<HTMLElement>('[data-start-ready]');
  if (ready) {
    const go = ready.querySelector<HTMLAnchorElement>('[data-start-go]')!;
    ready.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'plan_interest' && t.dataset.href) {
        go.href = t.dataset.href;
        go.dataset.checkout = t.value;
      }
    });
  }

  // "on the table": price saved for the chosen plan + the leak from the calculator
  const gain = document.querySelector<HTMLElement>('[data-gain]');
  if (gain) {
    const fmt = (v: number) => '$' + Math.round(v).toLocaleString('en-US');
    const paint = () => {
      const r = document.querySelector<HTMLInputElement>('#start input[name="plan_interest"]:checked');
      const save = Number(r?.dataset.save || 0);
      const live = document.querySelector('[data-math8] [data-v="lost"]')?.textContent?.replace(/[^0-9.]/g, '');
      const leak = live ? Number(live) * 12 : Number(gain.dataset.leak);
      gain.querySelector('[data-g="save"]')!.textContent = fmt(save);
      gain.querySelector('[data-g="leak"]')!.textContent = fmt(leak);
      gain.querySelector('[data-g="total"]')!.textContent = fmt(save + leak);
    };
    document.querySelector('#start')?.addEventListener('change', paint);
    window.addEventListener('cx:math', () => window.setTimeout(paint, 0));
    paint();
  }

</script>

<style>
  /* ---------- FAQ ---------- */
  .faq {
    padding-bottom: 0;
  }
  .fgrid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .fhead {
    display: grid;
    gap: var(--s-4);
    position: sticky;
    top: calc(var(--nav-h) + 24px);
  }
  details {
    border-top: 2px solid var(--ink);
  }
  details:last-child {
    border-bottom: 2px solid var(--ink);
  }
  summary {
    display: grid;
    grid-template-columns: 48px 1fr 36px;
    gap: 12px;
    align-items: center;
    padding-block: 22px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .qn {
    font-family: var(--f-head);
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--hot);
  }
  .qt {
    font-family: var(--f-head);
    font-weight: 700;
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.7rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }
  summary i {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    transition:
      background-color 200ms,
      rotate 300ms var(--ease);
  }
  summary i::before,
  summary i::after {
    content: '';
    position: absolute;
    left: 9px;
    right: 9px;
    top: 15px;
    height: 2px;
    background: var(--ink);
  }
  summary i::after {
    rotate: 90deg;
  }
  details[open] summary i {
    background: var(--hot);
    border-color: var(--hot);
    rotate: 45deg;
  }
  details[open] summary i::before,
  details[open] summary i::after {
    background: #fff;
  }
  details p {
    padding: 0 48px 26px 60px;
    color: var(--ink-2);
    line-height: 1.65;
    max-width: 70ch;
  }

  /* ---------- audit ---------- */
  .agrid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .acopy {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .steps {
    margin: 0;
    display: grid;
    gap: 14px;
    counter-reset: s;
  }
  .steps li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 14px;
    align-items: center;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.35;
  }
  .steps span {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-family: var(--f-head);
    font-weight: 700;
  }
  .steps li:last-child span {
    background: var(--hot);
  }
  .scope {
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .shell {
    position: relative;
    padding: clamp(1.5rem, 1rem + 2.2vw, 2.75rem);
    border-radius: 30px;
    background:
      radial-gradient(80% 50% at 100% 0%, rgba(255, 90, 31, 0.28), transparent 70%),
      linear-gradient(180deg, #111a23, #070b10);
    color: #eef3f7;
    color-scheme: dark;
    box-shadow: 0 50px 90px -50px rgba(11, 16, 22, 0.9);
  }
  .form {
    display: grid;
    gap: 14px;
  }
  .fh {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }
  .fh h3 {
    font-size: 1.5rem;
  }
  .fh span {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .fld {
    display: grid;
    gap: 6px;
  }
  label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #c5d0da;
  }
  label em {
    font-style: normal;
    font-weight: 500;
    color: var(--fog-2);
  }
  input,
  select,
  textarea {
    width: 100%;
    min-height: 50px;
    padding: 12px 16px;
    border-radius: 14px;
    border: 1.5px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    font: inherit;
    font-size: 1rem;
    transition:
      border-color 160ms,
      box-shadow 160ms,
      background-color 160ms;
  }
  select option {
    color: #0b1016;
  }
  textarea {
    resize: vertical;
  }
  input::placeholder,
  textarea::placeholder {
    color: #6c7a87;
  }
  input:hover,
  select:hover,
  textarea:hover {
    border-color: rgba(255, 255, 255, 0.32);
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--hot);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 4px rgba(255, 90, 31, 0.25);
  }
  [aria-invalid='true'] {
    border-color: #ff7a7a;
  }
  .err {
    display: none;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #ff9c9c;
  }
  .err:global(.show) {
    display: block;
  }
  .send {
    width: 100%;
    margin-top: 6px;
  }
  .status {
    font-size: 0.875rem;
    font-weight: 700;
  }
  .status:empty {
    display: none;
  }
  .status[data-tone='warn'] {
    padding: 10px 14px;
    border-radius: 12px;
    background: rgba(255, 196, 76, 0.16);
    color: #ffd98a;
  }
  .consent {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--fog-2);
  }
  .consent a {
    color: var(--fog);
  }
  .embed {
    width: 100%;
    min-height: 640px;
    border: 0;
    border-radius: 16px;
  }
  .ok {
    display: grid;
    gap: 10px;
    justify-items: start;
    padding-block: var(--s-7);
  }
  .ok[hidden] {
    display: none;
  }
  .ok span {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--mint);
    color: #04140c;
    font-size: 2rem;
    font-weight: 800;
  }
  .ok h3 {
    font-size: 2rem;
  }
  .ok p {
    color: var(--fog);
  }

  /* ---------- footer ---------- */
  .foot {
    background: var(--night);
    padding-block: clamp(4rem, 3rem + 5vw, 7rem) 120px;
    overflow: hidden;
  }
  .big {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: clamp(2.2rem, 1rem + 5.6vw, 6.4rem);
    line-height: 1;
    letter-spacing: -0.055em;
    max-width: 14ch;
  }
  .f-grid {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    padding-top: var(--s-6);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
    font-size: 0.9375rem;
    color: var(--fog);
  }
  .f-brand {
    display: grid;
