---
/**
 * "Who's behind CNVRT X": the founder, a short walkthrough of the real screens, the shop
 * the system already runs at, and how to reach us. It answers "who am I paying?" before the price.
 *
 * Real details only, from src/config/offerV9.ts (about, contact). Each part shows only when
 * its detail is filled in. With nothing filled in, the section is left off the live site;
 * on localhost it shows the empty layout and lists what is still needed.
 */
import { copyFor, type CopySet } from '../../content/copySets';
import { offerV9 as cfg } from '../../config/offerV9';
import { automotiveOffer as o } from '../../config/automotiveOffer';

interface Props {
  /** Which wording to use: the auto pages' (default) or the general one. See content/copySets.ts. */
  copy?: CopySet;
}
const { about9: c } = copyFor(Astro.props.copy);
const a = cfg.about;
const k = cfg.contact;
const hasFounder = Boolean(a.founderName);
const hasVideo = Boolean(a.videoUrl);
const hasStory = a.story.approved && Boolean(a.story.line);
const hasContact = Boolean(k.email || k.phone || k.address);
const any = hasFounder || hasVideo || hasStory || hasContact;
const dev = import.meta.env.DEV;
const missing = [!hasFounder && c.missing.founder, !hasVideo && c.missing.video, !hasStory && c.missing.story, !hasContact && c.missing.contact].filter(Boolean) as string[];
---

{
  (any || dev) && (
    <section class="scene about" id="about" aria-labelledby="about-title">
      <div class="container">
        <header class="head">
          <p class="kicker" data-reveal>{c.kicker}</p>
          <h2 id="about-title" class="t-lg" data-reveal>
            {c.title[0]} <span class="hot">{c.title[1]}</span>
          </h2>
        </header>

        {dev && missing.length > 0 && (
          <div class="preview">
            <p>{c.preview}</p>
            <ul role="list">
              {missing.map((m) => <li>{m}</li>)}
            </ul>
          </div>
        )}

        <div class="grid">
          {hasFounder && (
            <div class="who">
              {a.founderPhoto && <img src={a.founderPhoto} alt={a.founderName} width="96" height="96" loading="lazy" />}
              <p class="w-n">
                <b>{a.founderName}</b>
                {a.founderRole && <span>{a.founderRole}</span>}
              </p>
              {a.bio && <p class="w-b">{a.bio}</p>}
              <p class="w-co">{o.brand.legalName}</p>
            </div>
          )}

          {hasVideo && (
            <div class="vid">
              <p class="lab">{c.videoLabel}</p>
              <div class="frame">
                <iframe src={a.videoUrl} title={c.videoLabel} loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen />
              </div>
              <p class="v-n">{c.videoNote}</p>
            </div>
          )}

          {hasStory && (
            <div class="story">
              <p class="lab">{c.storyLabel}</p>
              <p class="s-l">{a.story.line}</p>
              {a.story.detail && <p class="s-d">{a.story.detail}</p>}
            </div>
          )}

          {hasContact && (
            <div class="reach">
              <p class="lab">{c.contactLabel}</p>
              {k.email && <a href={`mailto:${k.email}`}>{k.email}</a>}
              {k.phone && <a href={`tel:${k.phone.replace(/[^+\d]/g, '')}`}>{k.phone}</a>}
              {k.address && <p>{k.address}</p>}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .about {
    background: var(--night-2);
  }
  .head {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--s-4);
    align-items: stretch;
  }
  .grid > div {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
  }
  .lab {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #d8ff3e;
  }
  .who img {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
  }
  .w-n {
    display: grid;
    gap: 2px;
  }
  .w-n b {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: -0.03em;
  }
  .w-n span,
  .w-co,
  .v-n,
  .s-d {
    font-size: 0.9375rem;
    color: var(--fog);
  }
  .w-b {
    line-height: 1.55;
    color: #dbe4ec;
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
  }
  .frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .s-l {
    font-family: var(--f-head);
    font-weight: 700;
    font-size: clamp(1.2rem, 1.05rem + 0.7vw, 1.6rem);
    letter-spacing: -0.03em;
    line-height: 1.25;
  }
  .reach a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-family: var(--f-head);
    font-weight: 700;
    font-size: 1.1rem;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  .reach p {
    color: var(--fog);
    line-height: 1.5;
  }
  /* localhost only: what is still needed before this section goes live */
  .preview {
    margin-bottom: var(--s-4);
    padding: 16px 18px;
    border-radius: 16px;
    border: 1px dashed rgba(255, 196, 0, 0.6);
    color: #ffd666;
    font-size: 0.9375rem;
  }
  .preview ul {
    margin: 8px 0 0;
    padding-left: 1.2rem;
    list-style: disc;
    display: grid;
    gap: 4px;
  }
</style>
