---
/**
 * "Meet your new front desk": the voice demo.
 * - voiceDemo.enabled + voiceDemo.embed set: "Start talking" loads the embed. Nothing
 *   loads before that click. `embed` is a script URL or an HTML snippet.
 * - otherwise: the "try saying" lines become a static conversation labelled "Example conversation".
 * Every exchange here is written for an example shop. No real booking is made.
 */
import { copyFor, type CopySet } from '../../content/copySets';
import { offerV9 as cfg } from '../../config/offerV9';

/** A door page can give the demo its own headline and lead-in. The main page passes nothing. */
interface Props {
  title?: [string, string];
  body?: string;
  /** Which wording to use: the auto pages' (default) or the general one. See content/copySets.ts. */
  copy?: CopySet;
}
const { voice9: v } = copyFor(Astro.props.copy);
const { title = v.title as [string, string], body = v.body } = Astro.props;

const live = Boolean(cfg.voiceDemo.enabled && cfg.voiceDemo.embed);
const chat = cfg.chatDemo.enabled;
const arrow =
  '<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 5.500 15.500 10 11 14.500" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---

<section class="scene voice" id="front-desk" aria-labelledby="voice-title" data-voice9 data-state="idle" data-embed={live ? cfg.voiceDemo.embed : undefined}>
  <div class="container vgrid">
    <div class="copy">
      <p class="kicker" data-reveal>{v.kicker}</p>
      <h2 id="voice-title" class="t-lg" data-reveal>
        {title[0]} <span class="hot">{title[1]}</span>
      </h2>
      <p class="lede">{body}</p>

      <div class="say">
        <p class="say-h">{v.tryLabel}</p>
        {
          live ? (
            <ul role="list" class="chips">
              {v.examples.map((x) => <li>{x.q}</li>)}
            </ul>
          ) : (
            <div class="chips" role="group" aria-label={v.tryLabel}>
              {v.examples.map((x, i) => (
                <button type="button" data-ex={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                  {x.q}
                </button>
              ))}
            </div>
          )
        }
      </div>
      <p class="fine">{v.languages.replace('{langs}', cfg.aiLanguages)}</p>
    </div>

    <div class="stage">
      <span class="ex-tag">{live ? v.demoTag : v.exampleTag}</span>
      <div class="orb" aria-hidden="true"><i></i><i></i><b></b></div>

      {
        live ? (
          <div class="call">
            <p class="st" role="status" aria-live="polite" data-voice-status data-idle={v.idle} data-on={v.onCall} data-ended={v.afterCall}>
              {v.idle}
            </p>
            <div class="mount" data-voice-mount></div>
            <div class="btns" data-voice-idle>
              <button type="button" class="go" data-voice-start>{v.start}</button>
              {chat && (
                <button type="button" class="alt" data-chat-open>
                  {v.chat}
                </button>
              )}
            </div>
            <button type="button" class="alt" data-voice-end hidden>{v.end}</button>
            <a href="#pricing" class="go" data-voice-plans hidden data-track="cta_click" data-track-location="voice_demo">
              {v.plans}<Fragment set:html={arrow} />
            </a>
            <p class="fine">{v.limit}</p>
          </div>
        ) : (
          <div class="call">
            <div class="thread" aria-live="polite">
              {v.examples.map((x, i) => (
                <div class="turn" data-turn={i} hidden={i !== 0}>
                  <p class="bub you">{x.q}</p>
                  <p class="bub ai">{x.a}</p>
                </div>
              ))}
            </div>
            <a href="#pricing" class="go" data-track="cta_click" data-track-location="voice_demo">
              {v.plans}<Fragment set:html={arrow} />
            </a>
            <p class="fine">{v.exampleNote}</p>
          </div>
        )
      }
    </div>
  </div>
</section>

<a href="#front-desk" class="fab" data-voice-fab data-on="false" aria-label={live ? v.fabLive : v.fabExample} tabindex="-1">
  <span class="orb orb-s" aria-hidden="true"><b></b></span>
</a>

<script>
  import { track } from '../../scripts/analytics';

  const root = document.querySelector<HTMLElement>('[data-voice9]');
  if (root) {
    // static mode: each "try saying" line shows its example exchange
    const picks = [...root.querySelectorAll<HTMLButtonElement>('[data-ex]')];
    picks.forEach((b) =>
      b.addEventListener('click', () => {
        picks.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        root.querySelectorAll<HTMLElement>('[data-turn]').forEach((t) => (t.hidden = t.dataset.turn !== b.dataset.ex));
      }),
    );

    // live mode: the embed is loaded only after the visitor presses Start talking
    const startBtn = root.querySelector<HTMLButtonElement>('[data-voice-start]');
    const embed = root.dataset.embed;
    if (startBtn && embed) {
      const LIMIT = 180; // seconds
      const mount = root.querySelector<HTMLElement>('[data-voice-mount]')!;
      const status = root.querySelector<HTMLElement>('[data-voice-status]')!;
      const idle = root.querySelector<HTMLElement>('[data-voice-idle]')!;
      const endBtn = root.querySelector<HTMLButtonElement>('[data-voice-end]')!;
      const plans = root.querySelector<HTMLElement>('[data-voice-plans]')!;
      let t0 = 0;
      let timer = 0;

      const end = () => {
        if (root.dataset.state !== 'live') return;
        window.clearTimeout(timer);
        mount.innerHTML = '';
        root.dataset.state = 'ended';
        status.textContent = status.dataset.ended || '';
        endBtn.hidden = true;
        plans.hidden = false;
        idle.hidden = false;
        track('voice_demo_end', { seconds: Math.round((performance.now() - t0) / 1000) });
      };

      startBtn.addEventListener('click', () => {
        if (root.dataset.state === 'live') return;
        if (/^https?:\/\//.test(embed)) {
          const s = document.createElement('script');
          s.src = embed;
          s.async = true;
          mount.appendChild(s);
        } else {
          mount.innerHTML = embed;
          // scripts added through innerHTML do not run, so re-create them
          mount.querySelectorAll('script').forEach((old) => {
            const s = document.createElement('script');
            [...old.attributes].forEach((a) => s.setAttribute(a.name, a.value));
            s.textContent = old.textContent;
            old.replaceWith(s);
          });
        }
        root.dataset.state = 'live';
        status.textContent = status.dataset.on || '';
        idle.hidden = true;
        plans.hidden = true;
        endBtn.hidden = false;
        t0 = performance.now();
        timer = window.setTimeout(end, LIMIT * 1000);
        track('voice_demo_start');
      });
      endBtn.addEventListener('click', end);
    }

    // small floating orb (desktop): shown after the hero, hidden over this section, pricing and the reserve form
    const fab = document.querySelector<HTMLAnchorElement>('[data-voice-fab]');
    if (fab && 'IntersectionObserver' in window) {
      let past = false;
      const over = new Set<Element>();
      const sync = () => {
        const on = past && over.size === 0;
        fab.dataset.on = String(on);
        fab.tabIndex = on ? 0 : -1;
      };
      const hero = document.querySelector('#top');
      if (hero)
        new IntersectionObserver(([x]) => {
          past = !x.isIntersecting;
          sync();
        }).observe(hero);
      const io = new IntersectionObserver((es) => {
        es.forEach((x) => (x.isIntersecting ? over.add(x.target) : over.delete(x.target)));
        sync();
      });
      [root, document.querySelector('#pricing'), document.querySelector('#start'), document.querySelector('footer')].forEach((el) => el && io.observe(el));
    }
  }
</script>

<style>
  .voice {
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(50% 60% at 78% 50%, rgba(255, 90, 31, 0.16), transparent 70%),
      var(--night);
  }
  .vgrid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .say {
    display: grid;
    gap: 10px;
    width: 100%;
  }
  .say-h {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #d8ff3e;
  }
  .chips {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li,
  .chips button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
    color: #dbe4ec;
    font: inherit;
    font-size: 0.9375rem;
    line-height: 1.3;
    text-align: left;
  }
  .chips button {
    cursor: pointer;
    transition:
      border-color 160ms,
      background-color 160ms;
  }
  .chips button:hover {
    border-color: rgba(255, 255, 255, 0.5);
  }
  .chips button[aria-pressed='true'] {
    border-color: #d8ff3e;
    background: rgba(216, 255, 62, 0.1);
    color: #fff;
  }
  .chips button:focus-visible {
    outline: 3px solid #7cc4ff;
    outline-offset: 2px;
  }
  .fine {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--fog-2);
  }

  /* ---------- stage ---------- */
  .stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--s-5);
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    border-radius: 30px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015));
  }
  .ex-tag {
    justify-self: start;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #dbe4ec;
  }
  .orb {
    position: relative;
    width: clamp(120px, 80px + 9vw, 190px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .orb b {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, #ffd0b3 0%, var(--hot-2) 28%, var(--hot) 58%, #a82c05 100%);
    box-shadow:
      0 0 60px 6px rgba(255, 90, 31, 0.55),
      inset 0 -14px 30px rgba(120, 30, 0, 0.5);
    animation: orbBreathe 3.6s ease-in-out infinite;
  }
  .orb i {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 122, 69, 0.55);
    animation: orbRing 3.6s ease-out infinite;
  }
  .orb i + i {
    animation-delay: 1.8s;
  }
  /* while a call is live the orb moves like a voice */
  .voice[data-state='live'] .orb b {
    animation: orbVoice 1.1s ease-in-out infinite;
  }
  .voice[data-state='live'] .orb i {
    animation-duration: 1.4s;
  }
  .voice[data-state='live'] .orb i + i {
    animation-delay: 0.7s;
  }
  @keyframes orbBreathe {
    50% {
      transform: scale(1.05);
    }
  }
  @keyframes orbRing {
    from {
      transform: scale(1);
      opacity: 0.8;
    }
    to {
      transform: scale(1.5);
      opacity: 0;
    }
  }
  @keyframes orbVoice {
    0%,
    100% {
      transform: scale(1);
    }
    20% {
      transform: scale(1.1);
    }
    45% {
      transform: scale(1.03);
    }
    70% {
      transform: scale(1.14);
    }
  }
  .call {
    width: 100%;
    display: grid;
    gap: var(--s-4);
    justify-items: stretch;
  }
  .st {
    text-align: center;
    font-family: var(--f-head);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .btns {
    display: grid;
    gap: 10px;
  }
  .btns[hidden],
  .call [hidden] {
    display: none;
  }
  .call .go,
  .alt {
    width: 100%;
  }
  .alt {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    background: transparent;
    color: #fff;
    font-family: var(--f-head);
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }
  .alt:hover {
    border-color: #fff;
  }
  .thread {
    min-height: 9.5rem;
    display: grid;
    align-content: center;
  }
  .turn {
    display: grid;
    gap: 8px;
  }
  .bub {
    max-width: 88%;
    padding: 11px 15px;
    border-radius: 18px;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .bub.you {
    justify-self: end;
    background: #1f5fd6; /* white text passes contrast on this blue */
    color: #fff;
    border-bottom-right-radius: 5px;
    font-weight: 600;
  }
  .bub.ai {
    justify-self: start;
    background: #26323e;
    color: #eef3f7;
    border-bottom-left-radius: 5px;
  }
  .stage .fine {
    text-align: center;
  }

  /* ---------- floating orb (desktop only) ---------- */
  .fab {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 50;
    display: none;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    opacity: 0;
    transform: translateY(16px) scale(0.9);
    pointer-events: none;
    transition:
      opacity 280ms,
      transform 280ms var(--ease);
  }
  .fab[data-on='true'] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .fab:focus-visible {
    outline: 3px solid #7cc4ff;
    outline-offset: 4px;
  }
  .orb-s {
    width: 60px;
  }
  .orb-s b {
    box-shadow:
      0 0 26px 2px rgba(255, 90, 31, 0.6),
      inset 0 -6px 12px rgba(120, 30, 0, 0.5);
  }
  @media (min-width: 1000px) and (pointer: fine) {
    .fab {
      display: block;
    }
  }
  @media (max-width: 900px) {
    .vgrid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orb b,
    .orb i {
      animation: none !important;
    }
    .orb i {
      opacity: 0;
    }
  }
</style>
