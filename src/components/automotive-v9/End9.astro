---
import { audit } from '../../content/automotiveCopy';
import { faq9 as q, start9 as e, nav9, offer9, math9, footer9 as ft } from '../../content/automotiveCopyV9';
import { automotiveOffer as o, ATTRIBUTION_PARAMS } from '../../config/automotiveOffer';
import { offerV9 as cfg, checkoutHref } from '../../config/offerV9';

/** A door page puts its own questions first and uses its own start and closing lines. */
interface Props {
  faq?: { q: string; a: string }[];
  startLead?: string;
  footerLine?: string;
}
const { faq = [], startLead = e.lead, footerLine = e.footer } = Astro.props;
// page questions first, then the ones every buyer asks
const keep = ['Do I have to talk to a salesperson?', 'Can you guarantee bookings?', 'Can I cancel?', 'Is the AI a real person?'];
const faqItems = faq.length ? [...faq, ...q.items.filter((x) => keep.includes(x.q))] : q.items;

const mode = o.auditFormUrl ? o.auditFormMode : 'unconfigured';
const legal = [
  o.privacyUrl && { label: 'Privacy Policy', href: o.privacyUrl },
  o.termsUrl && { label: 'Terms', href: o.termsUrl },
  o.smsTermsUrl && { label: 'SMS Terms', href: o.smsTermsUrl },
  cfg.legal.cancellation && { label: 'Cancellation Policy', href: cfg.legal.cancellation },
  cfg.legal.disclaimer && { label: 'Disclaimer', href: cfg.legal.disclaimer },
].filter(Boolean) as { label: string; href: string }[];
const year = new Date().getFullYear();
const money = (n: number) => '$' + n.toLocaleString('en-US');
const plans = cfg.plans;
const live = cfg.checkoutLive;
// checkout link per plan and interval; '' when checkout is not live or the link is missing
const hrefs = Object.fromEntries(plans.map((pl) => [pl.id, { monthly: checkoutHref(pl.id, 'monthly'), annual: checkoutHref(pl.id, 'annual') }]));
const startHref = hrefs[plans.find((pl) => pl.popular)!.id].annual;
const md = math9.defaults;
const leakYear = Math.round(((md.missed * (52 / 12) * md.value) / md.oneIn) * 12);
const smsLinks = [
  { label: 'Privacy Policy', href: cfg.legal.privacy },
  { label: 'SMS Terms', href: cfg.legal.sms },
];
---

<section class="scene faq pearl" id="faq" aria-labelledby="faq9-title">
  <div class="container fgrid">
    <header class="fhead" data-reveal>
      <p class="kicker">{q.kicker}</p>
      <h2 id="faq9-title" class="t-lg">{q.title}</h2>
    </header>
    <div class="qa" data-faq9>
      {
        faqItems.map((f, i) => (
          <details>
            <summary>
              <span class="qn">{String(i + 1).padStart(2, '0')}</span>
              <span class="qt">{f.q}</span>
              <i aria-hidden="true" />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="scene audit pearl" id="start" aria-labelledby="start-title">
  <div class="container agrid">
    <div class="acopy">
      <p class="kicker" data-reveal>{e.kicker}</p>
      <h2 id="start-title" class="t-lg" data-reveal>
        <span class="rise"><span>{e.title[0]}</span></span>
        <span class="rise" style="--d:100ms"><span class="hot">{e.title[1]}</span></span>
      </h2>
      <p class="lede">{startLead}</p>
      <ol role="list" class="steps">
        {
          e.steps.map((s, i) => (
            <li>
              <span>{i + 1}</span>
              <div>
                <b>{s.t}</b>
                <small>{s.d}</small>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="shell">
      <form class="form" data-start9 data-mode={mode} data-hrefs={JSON.stringify(hrefs)} action={o.auditFormUrl || undefined} method="post" novalidate>
        <div class="fh">
          <h3>{live ? 'Start your build' : e.formTitle}</h3>
          <span>No sales call</span>
        </div>

        <div class="ivl" role="radiogroup" aria-label="Billing">
          <label>
            <input type="radio" name="billing_interval" value="monthly" />
            <span>Monthly</span>
          </label>
          <label>
            <input type="radio" name="billing_interval" value="annual" checked />
            <span>Annual <em>Pay 10, get 12</em></span>
          </label>
        </div>

        <div class="one-plan">
          <input type="hidden" name="plan_interest" value={plans[0].role} data-plan={plans[0].id} />
          <p class="op" data-ivl-show="annual">
            <b>{money(plans[0].annual)}</b> a year. Launch Kit waived.
          </p>
          <p class="op" data-ivl-show="monthly" hidden>
            <b>{money(plans[0].monthly)}</b> a month + {money(plans[0].launchKit)} one-time Launch Kit.
          </p>
        </div>
        <p class="found">
          {e.foundingNote}
          {cfg.foundingSpotsLeft !== null && <b> {cfg.foundingSpotsLeft} left.</b>}
        </p>

        <div class="gain" data-gain data-leak={leakYear}>
          <p class="g-h">{e.gainTitle}</p>
          <p class="g-r"><span>{e.gainRow}</span><b data-g="leak">{money(leakYear)}</b></p>
          <p class="g-n">{e.gainNote}</p>
        </div>

        {
          live && startHref ? (
            <>
              <a class="go" data-spot data-start-go href={startHref} data-checkout={plans.find((pl) => pl.popular)!.id} data-interval="annual" data-track="start_checkout_click">
                Continue to secure checkout
              </a>
              <p class="f-note">Next: secure checkout, then one short form. That is all you do.</p>
            </>
          ) : (
            <>
              <p class="f-note">{e.formNote}</p>
              <div class="two">
                <div class="fld">
                  <label for="s8-first">First name</label>
                  <input id="s8-first" name="first_name" autocomplete="given-name" required />
                  <p class="err" data-err="s8-first">Please add your first name.</p>
                </div>
                <div class="fld">
                  <label for="s8-biz">Business name</label>
                  <input id="s8-biz" name="business_name" autocomplete="organization" required />
                  <p class="err" data-err="s8-biz">Please add your business name.</p>
                </div>
              </div>
              <div class="two">
                <div class="fld">
                  <label for="s8-email">Email</label>
                  <input id="s8-email" name="email" type="email" autocomplete="email" required />
                  <p class="err" data-err="s8-email">Please enter a valid email address.</p>
                </div>
                <div class="fld">
                  <label for="s8-phone">Phone</label>
                  <input id="s8-phone" name="phone" type="tel" autocomplete="tel" required />
                  <p class="err" data-err="s8-phone">Please add a phone number.</p>
                </div>
              </div>

              <input type="hidden" name="landing_page" value="" data-landing />
              <input type="hidden" name="calc_estimate" value="" data-calc-field />
              {ATTRIBUTION_PARAMS.map((p) => <input type="hidden" name={p} value="" data-attr-field />)}

              <fieldset class="sms">
                <legend>Text messages (optional)</legend>
                <label class="ck">
                  <input type="checkbox" name="sms_account_consent" value="yes" />
                  <span>{e.sms.account}</span>
                </label>
                <label class="ck">
                  <input type="checkbox" name="sms_marketing_consent" value="yes" />
                  <span>{e.sms.marketing}</span>
                </label>
                <p class="consent">
                  {e.sms.note}
                  {smsLinks.map((l) => (
                    <>
                      {' '}
                      {l.href ? <a href={l.href} target="_blank" rel="noopener">{l.label}</a> : <span>{l.label}</span>}
                    </>
                  ))}
                </p>
              </fieldset>

              <button type="submit" class="go send" data-spot>
                {e.submit}
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 5.500 15.500 10 11 14.500" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </button>
              <p class="status" role="status" aria-live="polite" data-status></p>
            </>
          )
        }
      </form>
      <div class="ok" hidden data-ok8 tabindex="-1">
        <span aria-hidden="true">✓</span>
        <h3>You are on the list.</h3>
        <p>Watch your inbox for your join link.</p>
      </div>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="container">
    <div class="f-top">
      <p class="big chrome">{footerLine}</p>
      <a href="#pricing" class="go" data-track="cta_click" data-track-location="footer">
        {ft.cta}
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 5.500 15.500 10 11 14.500" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
    </div>

    <div class="f-card">
      <div class="f-brand">
        <a href="/automotive/v9" class="logo" aria-label="CNVRT X home page">CNVRT<b>✕</b></a>
        <p>{ft.blurb}</p>
        <p class="f-made">{ft.made}</p>
      </div>
      <nav aria-label="On this page">
        <p class="f-h">{ft.cols.page}</p>
        {nav9.links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="#faq">FAQ</a>
        <a href="#start">Get started</a>
      </nav>
      <nav aria-label="Legal">
        <p class="f-h">{ft.cols.legal}</p>
        {
          ft.legalLinks.map((label) => {
            const hit = legal.find((x) => x.label.toLowerCase().startsWith(label.toLowerCase().split(' ')[0]));
            return hit ? <a href={hit.href}>{label}</a> : <span class="soon" title="Page not published yet">{label}</span>;
          })
        }
      </nav>
      <div class="f-contact">
        <p class="f-h">{ft.cols.contact}</p>
        {o.contactUrl ? <a href={o.contactUrl}>Contact us</a> : <span class="soon" title="Contact link not set yet">Contact us</span>}
        <p class="f-co">{o.brand.legalName}</p>
      </div>
    </div>

    <div class="f-disc">
      {ft.disclaimers.map((d) => <p>{d}</p>)}
    </div>
    <div class="f-bot">
      <p>© {year} {o.brand.legalName}. All rights reserved.</p>
      <a href="#top">Back to top ↑</a>
    </div>
  </div>
</footer>

<script>
  import { track } from '../../scripts/analytics';

  document.querySelectorAll<HTMLDetailsElement>('[data-faq9] details').forEach((d) =>
    d.addEventListener('toggle', () => {
      if (d.open) track('faq_open', { question: d.querySelector('.qt')?.textContent || '' });
    }),
  );

  const form = document.querySelector<HTMLFormElement>('[data-start9]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]');
    const ok = document.querySelector<HTMLElement>('[data-ok8]')!;
    const landing = form.querySelector<HTMLInputElement>('[data-landing]');
    if (landing) landing.value = location.origin + location.pathname;

    let started = false;
    form.addEventListener('focusin', () => {
      if (started) return;
      started = true;
      track('start_form_start');
    });

    const req = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]')];
    const check = (el: HTMLInputElement | HTMLSelectElement) => {
      const good = el.value.trim() !== '' && el.checkValidity();
      el.setAttribute('aria-invalid', String(!good));
      const err = form.querySelector<HTMLElement>(`[data-err="${el.id}"]`);
      if (err) {
        err.id = `${el.id}-err`;
        el.setAttribute('aria-describedby', err.id);
        err.classList.toggle('show', !good);
      }
      return good;
    };
    req.forEach((el) => {
      el.addEventListener('blur', () => el.value && check(el));
      el.addEventListener('input', () => el.getAttribute('aria-invalid') === 'true' && check(el));
    });

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const bad = req.filter((f) => !check(f));
      if (bad.length) {
        bad[0].focus();
        return;
      }
      const est = document.querySelector('[data-math9] [data-odo-sr]')?.textContent;
      const calcField = form.querySelector<HTMLInputElement>('[data-calc-field]');
      if (calcField && est) calcField.value = est;

      const mode = form.dataset.mode;
      const data = new FormData(form);
      if (!status) return; // checkout is live: there are no fields to send
      track('start_form_submit', {
        plan: form.querySelector<HTMLInputElement>('input[name="plan_interest"]')?.dataset.plan || '',
        interval: String(data.get('billing_interval') || ''),
        configured: mode !== 'unconfigured',
      });
      if (mode === 'unconfigured') {
        status.textContent = 'This form is not connected yet. Set auditFormUrl in src/config/automotiveOffer.ts, or the checkout links in src/config/offerV9.ts.';
        status.dataset.tone = 'warn';
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      btn.disabled = true;
      status.textContent = 'Sending…';
      try {
        await fetch(form.action, { method: 'POST', body: data, mode: 'no-cors' });
        form.hidden = true;
        ok.hidden = false;
        ok.focus();
      } catch {
        status.textContent = 'Something went wrong. Please try again.';
        status.dataset.tone = 'warn';
        btn.disabled = false;
      }
    });
  }

  // plan + billing interval: one source for the price lines, the checkout link and the event
  const start = document.querySelector<HTMLElement>('#start');
  if (start) {
    const hrefs = JSON.parse(start.querySelector<HTMLElement>('[data-hrefs]')?.dataset.hrefs || '{}') as Record<string, Record<string, string>>;
    const one = <T extends HTMLElement>(sel: string) => start.querySelector<T>(sel);
    const sync = (fire: boolean) => {
      const plan = one<HTMLInputElement>('input[name="plan_interest"]');
      const interval = one<HTMLInputElement>('input[name="billing_interval"]:checked')?.value || 'annual';
      start.querySelectorAll<HTMLElement>('[data-ivl-show]').forEach((el) => (el.hidden = el.dataset.ivlShow !== interval));
      const go = one<HTMLAnchorElement>('[data-start-go]');
      const href = plan ? hrefs[plan.dataset.plan || '']?.[interval] : '';
      if (go && href && plan) {
        go.href = href;
        go.dataset.checkout = plan.dataset.plan;
        go.dataset.interval = interval;
      }
      if (fire && plan) track('plan_select', { plan: plan.dataset.plan || '', interval });
    };
    start.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'plan_interest' || t.name === 'billing_interval') sync(true);
    });
    // a plan button elsewhere on the page preselects the plan here
    window.addEventListener('cx:plan', (e) => {
      const d = (e as CustomEvent<string | { plan?: string; interval?: string }>).detail;
      const plan = typeof d === 'string' ? '' : d?.plan;
      const interval = typeof d === 'string' ? ({ Annual: 'annual', Monthly: 'monthly' } as Record<string, string>)[d] : d?.interval;
      const pick = (sel: string) => {
        const r = one<HTMLInputElement>(sel);
        if (r) r.checked = true;
      };
      if (interval) pick(`input[name="billing_interval"][value="${interval}"]`);
      if (plan) pick(`input[name="plan_interest"][data-plan="${plan}"]`);
      sync(false);
    });
    sync(false);
  }

  // "on the table": the yearly leak from the visitor's own calculator numbers
  const gain = document.querySelector<HTMLElement>('[data-gain]');
  if (gain) {
    const fmt = (v: number) => '$' + Math.round(v).toLocaleString('en-US');
    const paint = () => {
      const liveLost = document.querySelector('[data-math9] [data-v="lost"]')?.textContent?.replace(/[^0-9.]/g, '');
      const leak = liveLost ? Number(liveLost) * 12 : Number(gain.dataset.leak);
      gain.querySelector('[data-g="leak"]')!.textContent = fmt(leak);
    };
    window.addEventListener('cx:math', () => window.setTimeout(paint, 0));
    paint();
  }
</script>

<style>
  /* ---------- FAQ ---------- */
  .faq {
    padding-bottom: 0;
  }
  .fgrid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .fhead {
    display: grid;
    gap: var(--s-4);
    position: sticky;
    top: calc(var(--nav-h) + 24px);
  }
  details {
    border-top: 2px solid var(--ink);
  }
  details:last-child {
    border-bottom: 2px solid var(--ink);
  }
  summary {
    display: grid;
    grid-template-columns: 48px 1fr 36px;
    gap: 12px;
    align-items: center;
    padding-block: 22px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .qn {
    font-family: var(--f-head);
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--hot);
  }
  .qt {
    font-family: var(--f-head);
    font-weight: 700;
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.7rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }
  summary i {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    transition:
      background-color 200ms,
      rotate 300ms var(--ease);
  }
  summary i::before,
  summary i::after {
    content: '';
    position: absolute;
    left: 9px;
    right: 9px;
    top: 15px;
    height: 2px;
    background: var(--ink);
  }
  summary i::after {
    rotate: 90deg;
  }
  details[open] summary i {
    background: var(--hot);
    border-color: var(--hot);
    rotate: 45deg;
  }
  details[open] summary i::before,
  details[open] summary i::after {
    background: #fff;
  }
  details p {
    padding: 0 48px 26px 60px;
    color: var(--ink-2);
    line-height: 1.65;
    max-width: 70ch;
  }

  /* ---------- audit ---------- */
  .agrid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .acopy {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .steps {
    margin: 0;
    display: grid;
    gap: 14px;
    counter-reset: s;
  }
  .steps li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 14px;
    align-items: center;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.35;
  }
  .steps span {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-family: var(--f-head);
    font-weight: 700;
  }
  .steps li:last-child span {
    background: var(--hot);
  }
  .scope {
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .shell {
    position: relative;
    padding: clamp(1.5rem, 1rem + 2.2vw, 2.75rem);
    border-radius: 30px;
    background:
      radial-gradient(80% 50% at 100% 0%, rgba(255, 90, 31, 0.28), transparent 70%),
      linear-gradient(180deg, #111a23, #070b10);
    color: #eef3f7;
    color-scheme: dark;
    box-shadow: 0 50px 90px -50px rgba(11, 16, 22, 0.9);
  }
  .form {
    display: grid;
    gap: 14px;
  }
  .fh {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }
  .fh h3 {
    font-size: 1.5rem;
  }
  .fh span {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .fld {
    display: grid;
    gap: 6px;
  }
  label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #c5d0da;
  }
  label em {
    font-style: normal;
    font-weight: 500;
    color: var(--fog-2);
  }
  input,
  select,
  textarea {
    width: 100%;
    min-height: 50px;
    padding: 12px 16px;
    border-radius: 14px;
    border: 1.5px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    font: inherit;
    font-size: 1rem;
    transition:
      border-color 160ms,
      box-shadow 160ms,
      background-color 160ms;
  }
  select option {
    color: #0b1016;
  }
  textarea {
    resize: vertical;
  }
  input::placeholder,
  textarea::placeholder {
    color: #6c7a87;
  }
  input:hover,
  select:hover,
  textarea:hover {
    border-color: rgba(255, 255, 255, 0.32);
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--hot);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 4px rgba(255, 90, 31, 0.25);
  }
  [aria-invalid='true'] {
    border-color: #ff7a7a;
  }
  .err {
    display: none;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #ff9c9c;
  }
  .err:global(.show) {
    display: block;
  }
  .send {
    width: 100%;
    margin-top: 6px;
  }
  .status {
    font-size: 0.875rem;
    font-weight: 700;
  }
  .status:empty {
    display: none;
  }
  .status[data-tone='warn'] {
    padding: 10px 14px;
    border-radius: 12px;
    background: rgba(255, 196, 76, 0.16);
    color: #ffd98a;
  }
  .consent {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--fog-2);
  }
  .consent a {
    color: var(--fog);
  }
  .embed {
    width: 100%;
    min-height: 640px;
    border: 0;
    border-radius: 16px;
  }
  .ok {
    display: grid;
    gap: 10px;
    justify-items: start;
    padding-block: var(--s-7);
  }
  .ok[hidden] {
    display: none;
  }
  .ok span {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--mint);
    color: #04140c;
    font-size: 2rem;
    font-weight: 800;
  }
  .ok h3 {
    font-size: 2rem;
  }
  .ok p {
    color: var(--fog);
  }

  /* ---------- footer ---------- */
  .foot {
