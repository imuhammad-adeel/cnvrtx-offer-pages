  }
  .costs b {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.03em;
    color: var(--ink);
    white-space: nowrap;
  }
  .costs .us {
    border: 0;
    background: var(--ink);
    color: #d8ff3e;
  }
  .costs .us b {
    color: #fff;
  }
  .after {
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    display: grid;
    gap: var(--s-3);
  }
  .h-close {
    font-family: var(--f-head);
    font-weight: 700;
    font-size: clamp(1.2rem, 1rem + 0.9vw, 1.7rem);
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .h-foot {
    max-width: 110ch;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* ---------- v9: the monthly bill ---------- */
  .right {
    display: grid;
    gap: var(--s-4);
  }
  .bill {
    width: 100%;
    display: grid;
    padding: clamp(1.1rem, 0.9rem + 1vw, 1.75rem);
    border-radius: 22px;
    background: #fff;
    border: 1px solid rgba(11, 16, 22, 0.08);
    box-shadow: 0 30px 60px -40px rgba(11, 16, 22, 0.45);
    color: var(--ink);
  }
  .b-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .b-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 14px;
    align-items: center;
    padding: 12px 0;
    border-top: 1.5px dashed rgba(11, 16, 22, 0.18);
  }
  .b-k {
    font-weight: 700;
    line-height: 1.3;
  }
  .b-k small {
    display: block;
