  }
  .b-x b {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem);
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--hot);
  }
  .b-note {
    margin-top: 10px;
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* ---------- v9: headline on top, then two equal columns ---------- */
  .whead {
