---
/** Exit popup. No price anchor: it shows the visitor's own calculator loss and the founding program. */
import { copyFor, type CopySet } from '../../content/copySets';

interface Props {
  /** Which wording to use: the auto pages' (default) or the general one. See content/copySets.ts. */
  copy?: CopySet;
}
const { exit9: x, math9 } = copyFor(Astro.props.copy);

const fmt = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const d = math9.defaults;
const lostDefault = (d.missed * (52 / 12) * d.value) / d.oneIn;
const leakParts = x.leak.split('{lost}');
---

{
  x.enabled && (
    <dialog class="exit" data-exit9 aria-labelledby="exit-title">
      <form method="dialog" class="x-form">
        <button class="x-close" aria-label="Close" value="close">×</button>
      </form>
      <p class="x-eye">{x.eyebrow}</p>
      <h2 id="exit-title">{x.title}</h2>

      <ul role="list" class="loss">
        <li>
          {leakParts[0]}<b data-exit-lost>{fmt(lostDefault)}</b>{leakParts[1]}
          <small>{x.leakNote}</small>
        </li>
        <li>{x.founding}</li>
      </ul>

      <a class="go" href="#pricing" data-track="exit_offer_click" data-exit-go>
        {x.cta}
      </a>
      <form method="dialog">
        <button class="x-no" value="no">{x.no}</button>
      </form>
    </dialog>
  )
}

<script>
  import { track } from '../../scripts/analytics';

  const dlg = document.querySelector<HTMLDialogElement>('[data-exit9]');
  if (dlg && typeof dlg.showModal === 'function') {
    const KEY = 'cx_exit9_seen';
    let seen = false;
    try {
      seen = sessionStorage.getItem(KEY) === '1';
    } catch {}
    const born = Date.now();
    let engaged = false; // they already pressed a start button, so do not interrupt
    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement)?.closest('[data-plan-cta], [data-start9] button, [data-start-go]')) engaged = true;
    });

    const open = (why: string) => {
      if (seen || engaged || dlg.open || Date.now() - born < 6000) return;
      const a = document.activeElement as HTMLElement | null;
      if (a && /^(INPUT|SELECT|TEXTAREA)$/.test(a.tagName)) return;
      seen = true;
      try {
        sessionStorage.setItem(KEY, '1');
      } catch {}
      // use the visitor's own calculator result if they changed it
      const live = document.querySelector('[data-math9] [data-v="lost"]')?.textContent;
      const slot = dlg.querySelector('[data-exit-lost]');
      if (live && slot) slot.textContent = live;
      dlg.showModal();
      track('exit_offer_shown', { trigger: why });
    };

    // desktop: the pointer leaves through the top of the window
    document.addEventListener('mouseout', (e) => {
      if (!e.relatedTarget && e.clientY <= 0) open('mouse_top');
    });

    // touch: a fast scroll back up after reading a good part of the page
    if (window.matchMedia('(pointer: coarse)').matches) {
      let last = window.scrollY;
      let lastT = performance.now();
      window.addEventListener(
        'scroll',
        () => {
          const now = performance.now();
          const dy = window.scrollY - last;
          const dt = now - lastT || 16;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          if (dy < -60 && dy / dt < -2.2 && window.scrollY / max > 0.35) open('scroll_up');
          last = window.scrollY;
          lastT = now;
        },
        { passive: true },
      );
    }

    dlg.querySelector('[data-exit-go]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
  }
</script>

<style>
  .exit {
    width: min(560px, calc(100vw - 32px));
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    border-radius: 28px;
    background:
      radial-gradient(90% 60% at 100% 0%, rgba(255, 90, 31, 0.3), transparent 70%),
      linear-gradient(180deg, #131c25, #070b10);
    color: #eef3f7;
    box-shadow: 0 60px 120px -40px rgba(0, 0, 0, 0.9);
  }
  .exit[open] {
    display: grid;
    gap: 16px;
    animation: exIn 380ms cubic-bezier(0.2, 0.9, 0.2, 1);
  }
  .exit::backdrop {
    background: rgba(5, 8, 11, 0.74);
    backdrop-filter: blur(6px);
  }
  @keyframes exIn {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.97);
    }
  }
  .x-form {
    position: absolute;
    top: 10px;
    right: 10px;
  }
  .x-close {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .x-close:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  .x-eye {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #d8ff3e;
  }
  h2 {
    font-size: clamp(1.8rem, 1.4rem + 2vw, 2.8rem);
    letter-spacing: -0.05em;
    line-height: 1.02;
    max-width: 14ch;
  }
  .cmp {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .cmp p {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border-radius: 18px;
  }
  .cmp span {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .cmp b {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.4rem);
    letter-spacing: -0.06em;
    line-height: 1;
  }
  .cmp small {
    font-size: 0.8125rem;
  }
  .c-now {
    background: #d8ff3e;
    color: #0b1016;
  }
  .c-later {
    background: rgba(255, 90, 90, 0.12);
    border: 1px solid rgba(255, 90, 90, 0.5);
    color: #ffb3b3;
  }
  .c-later b {
    color: #ff7a7a;
  }
  .loss {
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .loss li {
    position: relative;
    padding-left: 22px;
    line-height: 1.45;
    color: #dbe4ec;
  }
  .loss li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff6b6b;
  }
  .loss b {
    color: #ff8f8f;
    font-family: var(--f-head);
    font-size: 1.15em;
  }
  .loss small {
    display: block;
    font-size: 0.75rem;
    color: var(--fog-2);
  }
  .go {
    width: 100%;
    margin-top: 4px;
  }
  .x-no {
    width: 100%;
    min-height: 44px;
    border: 0;
    background: none;
    color: var(--fog-2);
    font: inherit;
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .x-no:hover {
    color: #fff;
  }
  @media (prefers-reduced-motion: reduce) {
    .exit[open] {
      animation: none;
    }
  }
</style>
